  </style>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-example-tab]"));
    const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-example-panel]"));
    const results = Array.from(document.querySelectorAll<HTMLElement>("[data-example-result]"));
    const copyActiveButton = document.querySelector<HTMLButtonElement>("#copy-active-script");
    const isJa = document.documentElement.lang === "ja";

    function activateExample(id: string) {
      tabs.forEach((tab) => {
        const active = tab.dataset.exampleTab === id;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
      });

      panels.forEach((panel) => {
        panel.hidden = panel.dataset.examplePanel !== id;
      });

      results.forEach((result) => {
        result.hidden = result.dataset.exampleResult !== id;
      });
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => activateExample(tab.dataset.exampleTab ?? ""));
      tab.addEventListener("keydown", (event) => {
        if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return;
        event.preventDefault();
        const nextIndex =
          event.key === "ArrowRight"
            ? (index + 1) % tabs.length
            : (index - 1 + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        if (!nextTab) return;
        activateExample(nextTab.dataset.exampleTab ?? "");
        nextTab.focus();
      });
    });

    async function copyText(text: string, button: HTMLElement) {
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = "true";
        const originalLabel = button.getAttribute("aria-label");
        button.setAttribute("aria-label", isJa ? "コピー済み" : "已複製");
        window.setTimeout(() => {
          delete button.dataset.copied;
          if (originalLabel) button.setAttribute("aria-label", originalLabel);
        }, 1500);
      } catch {
        button.dataset.copied = "error";
      }
    }

    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", () => copyText(button.dataset.copy ?? "", button));
    });

    copyActiveButton?.addEventListener("click", () => {
      const activePanel = panels.find((panel) => !panel.hidden);
      if (activePanel) copyText(activePanel.dataset.script ?? "", copyActiveButton);
    });
  </script>
</BaseLayout>
