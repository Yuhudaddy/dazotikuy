    .ist-code-panel {
      min-height: 340px;
      padding: 26px 0 30px;
      color: var(--ist-code);
    }

    .ist-code-panel[hidden] {
      display: none;
    }

    .ist-code-meta {
      display: grid;
      gap: 7px;
      padding: 0 26px 22px 62px;
      border-bottom: 1px solid var(--ist-line-soft);
    }

    .ist-code-meta span {
