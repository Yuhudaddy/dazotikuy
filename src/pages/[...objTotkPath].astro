---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { GAME_LOGOS } from "../data/gameLogos";
import { uiStrings, type Lang } from "../data/ui-strings";

// 中文 /resources/object-map/totk、日文 /ja/resources/object-map/totk
export function getStaticPaths() {
  return [
    { params: { objTotkPath: "resources/object-map/totk" }, props: { lang: "zh" as Lang } },
    { params: { objTotkPath: "ja/resources/object-map/totk" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];

const MAP_URL = "https://objmap-totk.zeldamods.org/";

const queryExamples = [
  {
    label: "基本名稱",
    labelJa: "基本の名前",
    query: "Construct",
    description: "同時搜尋顯示名稱與遊戲內部資料。",
    descriptionJa: "表示名と内部データを同時に検索する。",
  },
  {
    label: "完整片語",
    labelJa: "完全一致のフレーズ",
    query: '"Soldier Construct"',
    description: "用引號包住完整名稱，避免拆成多個關鍵字。",
    descriptionJa: "名前全体を引用符で囲み、複数のキーワードに分割されるのを防ぐ。",
  },
  {
    label: "同時符合",
    labelJa: "複数条件を同時に満たす",
    query: 'Gleeok "King Gleeok"',
    description: "空格等同 AND，只留下同時符合兩個條件的結果。",
    descriptionJa: "スペースは AND と同じ意味になり、両方の条件を満たす結果だけが残る。",
  },
  {
    label: "排除結果",
    labelJa: "結果を除外",
    query: 'Gleeok NOT "King Gleeok"',
    description: "保留 Gleeok，但排除含有 King Gleeok 的項目。",
    descriptionJa: "Gleeok は残しつつ、King Gleeok を含む項目を除外する。",
  },
  {
    label: "萬用字元",
    labelJa: "ワイルドカード",
    query: "TBox_* scale:0",
    description: "搜尋不隨世界等級變化的 TBox 系列寶箱物件。",
    descriptionJa: "ワールドレベルで変化しない TBox 系統の宝箱オブジェクトを検索する。",
  },
];

// 王淚版只支援以下 6 個欄位（官方 Help 的 Available columns，並已逐一實測）。
// 曠野版另有的 drop / equip / onehit / lastboss / hard / no_rankup / bonus
// 在王淚會直接回報「Could not understand search query」，因此不列在這裡。
const fieldFilters = [
  { field: "map", value: "Surface_D-5", use: "限定地圖或地圖單位（Surface／Depths／Sky）", useJa: "地図またはマップユニットを限定（Surface／Depths／Sky）" },
  { field: "static", value: "1", use: "1 為 Static，0 為 Dynamic", useJa: "1 が Static、0 が Dynamic" },
  { field: "actor", value: "Enemy_Zonau_Golem_Junior", use: "依遊戲內部 Actor 名稱搜尋", useJa: "ゲーム内部の Actor 名で検索" },
  { field: "name", value: '"Soldier Construct"', use: "依玩家看見的物件名稱搜尋", useJa: "プレイヤーに表示される物体名で検索" },
  { field: "data", value: "IsGround", use: "搜尋物件內部資料", useJa: "物体の内部データを検索" },
  { field: "scale", value: "0", use: "不會隨世界等級變化", useJa: "ワールドレベルで変化しない" },
];

const mapTools = [
  {
    no: "01",
    title: "Add to map",
    text: "搜尋完成後，把整組結果加入地圖。不同搜尋可以保留為不同顏色的群組。",
    textJa: "検索が終わったら、結果一式を地図に追加する。検索ごとに異なる色のグループとして残せる。",
  },
  {
    no: "02",
    title: "Filter",
    text: "控制地名、神廟、塔、商店、克洛格與可見地圖區域，降低畫面上的資訊量。",
    textJa: "地名、祠、塔、店、コログ、表示するマップ範囲などを絞り込み、画面上の情報量を減らす。",
  },
  {
    no: "03",
    title: "Go to coordinates",
    text: "輸入座標直接前往目標位置，適合搭配遊戲內座標或研究資料使用。",
    textJa: "座標を入力して目的の位置へ直接移動する。ゲーム内座標や調査データと組み合わせるのに向いている。",
  },
  {
    no: "04",
    title: "Object Display",
    text: "可切換內部 Actor 名稱、Hash ID、高度、位置與物件卸載範圍等進階資訊。",
    textJa: "内部の Actor 名、Hash ID、高度、座標、オブジェクトのアンロード範囲といった詳細情報を切り替えて表示できる。",
  },
];
---

<BaseLayout
  title={t.objMapTotkTitle}
  description={t.objMapTotkDescription}
  active="resources"
  lang={lang}
  altPath="/resources/object-map/totk"
>
  <div class="obj-guide">
    <div class="obj-hero-shell">
      <div class="obj-hero-canvas" aria-hidden="true">
        <img
          class="obj-hero-map"
          src={href("/resource-guides/totk-object-map.jpg")}
          alt=""
          width="960"
          height="332"
          fetchpriority="high"
        />
        <div class="obj-hero-shade"></div>
      </div>

    <section class="obj-hero" aria-labelledby="guide-title">
      <div class="obj-scan" aria-hidden="true">
        <span class="obj-scan-ring obj-scan-ring-a"></span>
        <span class="obj-scan-ring obj-scan-ring-b"></span>
        <span class="obj-scan-cross obj-scan-cross-x"></span>
        <span class="obj-scan-cross obj-scan-cross-y"></span>
        <span class="obj-scan-dot"></span>
      </div>

      <div class="obj-hero-inner">
        <nav class="obj-breadcrumb" aria-label={t.breadcrumbLabel}>
          <a href={href("/home", lang)}>{t.breadcrumbHome}</a>
          <span>/</span>
          <a href={href("/resources#totk", lang)}>{t.navResources}</a>
          <span>/</span>
          <span aria-current="page">{lang === "ja" ? "オブジェクトマップ" : "物件地圖"}</span>
        </nav>

        <div class="obj-hero-content">
          <div class="obj-kicker">
            <svg viewBox={GAME_LOGOS.totk.viewBox} aria-hidden="true" set:html={GAME_LOGOS.totk.svg} />
            <span>Tears of the Kingdom · Object Map Guide</span>
          </div>
          <h1 id="guide-title">{t.objMapTotkTitle}</h1>
          <p>
            {lang === "ja"
              ? "素材や魔物だけでなく、すべての Actor、オブジェクトの判定範囲、座標まで探せる。"
              : "不只材料和魔物，所有 Actor、物件判定範圍、座標都能找到。"}
          </p>

          <div class="obj-hero-meta">
            <span>Created by Léo Lam</span>
            <span>{"English interface"}</span>
            <span>{"Advanced object data"}</span>
          </div>

          <div class="obj-hero-actions">
            <a class="obj-primary-action" href={MAP_URL} target="_blank" rel="noopener">
              <span>{lang === "ja" ? "ティアキンのオブジェクトマップを開く" : "開啟王淚物件地圖"}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M14 5h5v5M19 5l-8 8M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
              </svg>
            </a>
            <a class="obj-secondary-action" href={href("/resources#totk", lang)}>{t.subpageBackToResources}</a>
          </div>
        </div>

        <div class="obj-coordinate" aria-hidden="true">
          <span>SCAN AREA</span>
          <strong>SKY MAP</strong>
          <span>X 1888 · Y -1218 · Z -1203.69</span>
        </div>
      </div>
    </section>

    <nav class="obj-section-nav" aria-label={lang === "ja" ? "ページ内セクション" : "本頁章節"}>
      <div class="obj-section-nav-inner">
        <span class="obj-section-nav-label">GUIDE / 01</span>
        <a href="#start">{lang === "ja" ? "クイックスタート" : "快速開始"}</a>
        <a href="#syntax">{lang === "ja" ? "検索構文" : "搜尋語法"}</a>
        <a href="#filters">{lang === "ja" ? "フィールド絞り込み" : "欄位篩選"}</a>
        <a href="#tools">{lang === "ja" ? "マップツール" : "地圖工具"}</a>
        <a href="#notes">注意事項</a>
      </div>
    </nav>
    </div>

    <section id="start" class="obj-section obj-section-intro obj-reveal">
      <div class="obj-wrap">
        <div class="obj-section-heading">
          <span>{lang === "ja" ? "START HERE · クイックスタート" : "START HERE · 快速開始"}</span>
          <h2>{lang === "ja" ? "入力方法" : "輸入方式"}</h2>
        </div>

        <div class="obj-start-grid">
          <article>
            <span class="obj-step-no">01</span>
            <h3>{lang === "ja" ? "英語名" : "英文名稱"}</h3>
            <p>
              {lang === "ja" ? (
                <><a class="obj-inline-link" href="https://docs.google.com/spreadsheets/d/1wLoabOgGwh6ST23-lgQG8O6oKdKwwAyb75fzwH5FYpE/edit?gid=0#gid=0" target="_blank" rel="noopener">中英対照表</a>を参考に、検索したい対象の英語名または Actor 名を入力する。</>
              ) : (
                <>參考<a class="obj-inline-link" href="https://docs.google.com/spreadsheets/d/1wLoabOgGwh6ST23-lgQG8O6oKdKwwAyb75fzwH5FYpE/edit?gid=0#gid=0" target="_blank" rel="noopener">中英文對照</a>，輸入搜尋目標的英文或 Actor 名稱。</>
              )}
            </p>
            <div class="obj-step-examples">
              <div class="obj-step-example">
                <code>Areaculling</code>
                <span>{lang === "ja" ? "カリングエリア" : "隱藏區"}</span>
              </div>
            </div>
          </article>
          <article>
            <span class="obj-step-no">02</span>
            <h3>{lang === "ja" ? "演算子" : "運算子"}</h3>
            <p>{lang === "ja" ? (
              <>アンカー <code>^</code>、前方一致 <code>*</code>、フレーズ <code>""</code>、ブール演算（<code>AND</code> / <code>NOT</code> / <code>OR</code>）を組み合わせて、より細かい内容を検索する。</>
            ) : (
              <>加入錨點 <code>^</code>、前綴 <code>*</code>、片語 <code>""</code>、布林運算（<code>AND</code> / <code>NOT</code> / <code>OR</code>），查詢更細節的內容。</>
            )}</p>
            <div class="obj-step-examples">
              <div class="obj-step-example">
                <code>^Lynel</code>
                <span>{lang === "ja" ? "Lynel が先頭にくる結果だけが出る。Silver Lynel のように Lynel が後ろにつく結果は出ない" : "只會出現 Lynel 作為前綴開頭的結果，如 Silver Lynel 之類 Lynel 出現在後面的結果不會出現"}</span>
              </div>
            </div>
          </article>
          <article>
            <span class="obj-step-no">03</span>
            <h3>{lang === "ja" ? "絞り込み" : "篩選"}</h3>
            <p>{lang === "ja" ? (
              <>「どの地図か」「強化されるか」など、<code>フィールド:</code> を加えるとさらに細かい結果を絞り込める</>
            ) : (
              <>加入 <code>欄位:</code> 可以篩選出更細節的結果，如「在哪張地圖」「會不會升級」</>
            )}</p>
            <div class="obj-step-examples">
              <div class="obj-step-example">
                <code>static:1</code>
                <span>{lang === "ja" ? "Static のマップユニットにあるオブジェクト。0 は Dynamic" : "位於 Static 地圖單位的物件，0 則為 Dynamic"}</span>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="syntax" class="obj-section obj-section-lab obj-reveal">
      <div class="obj-wrap obj-lab-layout">
        <div class="obj-lab-copy">
          <div class="obj-section-heading">
            <span>{lang === "ja" ? "QUERY LAB · クエリラボ" : "QUERY LAB · 搜尋式組合器"}</span>
            <h2>{lang === "ja" ? "条件の組み合わせを試す" : "練習條件組合"}</h2>
          </div>
          <p>
            {lang === "ja" ? (
              <>右側をクリックして検索の構文を体験してみよう。スペースは <code>AND</code> と同じ意味で、<code>NOT</code> は条件に合う結果を除外する。</>
            ) : (
              <>點擊右邊試著了解搜尋的語法。空格代表 <code>AND</code>，
              <code>NOT</code> 會排除符合的結果。</>
            )}
          </p>

          <div class="obj-query-output" aria-live="polite">
            <span>SEARCH QUERY</span>
            <code id="query-output" class="is-placeholder">{lang === "ja" ? "右側の内容をクリック" : "請點擊右側內容"}</code>
            <button id="copy-query" type="button" data-copy-target="query-output">
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
              </svg>
              <span>{lang === "ja" ? "検索式をコピー" : "複製搜尋式"}</span>
            </button>
          </div>
        </div>

        <div class="obj-query-controls" role="group" aria-label={lang === "ja" ? "検索条件" : "搜尋條件"}>
          <div>
            <span class="obj-control-label">{lang === "ja" ? "基本キーワード" : "基本關鍵字"}</span>
            <select id="query-base" class="obj-base-select" aria-label={lang === "ja" ? "基本キーワードを選択" : "選擇基本關鍵字"}>
              <option value="" selected disabled>{lang === "ja" ? "選択してください…" : "請選擇…"}</option>
              <option value="Bokoblin">{lang === "ja" ? "ボコブリン" : "波克布林"}</option>
              <option value="Mobli*">{lang === "ja" ? "モリブリン" : "莫力布"}</option>
              <option value="Lynel">{lang === "ja" ? "ライネル" : "萊尼爾"}</option>
              <option value={'"Lynel Bow"'}>{lang === "ja" ? "ライネルの弓" : "萊尼爾之弓"}</option>
            </select>
          </div>
          <button type="button" class="obj-token" data-query-token={'NOT "Lynel Bow"'} aria-pressed="false">
            <span>{lang === "ja" ? "ライネルの弓を装備していない" : "沒有裝備萊尼爾之弓"}</span>
            <code>NOT "Lynel Bow"</code>
          </button>
          <button type="button" class="obj-token" data-query-token="scale:0" aria-pressed="false">
            <span>{lang === "ja" ? "ワールドレベルで変化しない" : "不隨世界等級變化"}</span>
            <code>scale:0</code>
          </button>
          <button type="button" class="obj-token" data-query-token="static:1" aria-pressed="false">
            <span>{lang === "ja" ? "固定配置" : "Static 固定物件"}</span>
            <code>static:1</code>
          </button>
        </div>
      </div>
    </section>

    <section class="obj-section obj-reveal" aria-labelledby="recipes-title">
      <div class="obj-wrap">
        <div class="obj-section-heading obj-heading-row">
          <div>
            <span>{lang === "ja" ? "SEARCH RECIPES · 検索構文リファレンス" : "SEARCH RECIPES · 語法參考"}</span>
            <h2 id="recipes-title">{lang === "ja" ? "基本の検索構文" : "基本的搜尋語法"}</h2>
          </div>
          <p>{lang === "ja" ? "各行右側のアイコンをクリックするとコピーできる" : "點擊每列右側圖示即可複製"}</p>
        </div>

        <div class="obj-recipe-list">
          {queryExamples.map((item, index) => (
            <article class="obj-recipe" style={`--i:${index}`}>
              <span class="obj-recipe-label">{lang === "ja" ? item.labelJa : item.label}</span>
              <code>{item.query}</code>
              <p>{lang === "ja" ? item.descriptionJa : item.description}</p>
              <button type="button" class="obj-copy-icon" data-copy={item.query} aria-label={lang === "ja" ? `「${item.query}」をコピー` : `複製「${item.query}」`} title={lang === "ja" ? "検索式をコピー" : "複製搜尋式"}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <rect x="8" y="8" width="11" height="11" rx="2"></rect>
                  <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path>
                </svg>
              </button>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="filters" class="obj-section obj-section-filters obj-reveal">
      <div class="obj-wrap obj-filter-layout">
        <div class="obj-section-heading obj-filter-intro">
          <span>{lang === "ja" ? "COLUMN FILTERS · フィールド絞り込み" : "COLUMN FILTERS · 欄位篩選"}</span>
          <h2>{lang === "ja" ? "結果を絞り込む" : "進階搜尋"}</h2>
          <p>
            {lang === "ja" ? (
              <>フィールド構文は必ず <code>COLUMN:QUERY</code> の形を使う。複数のフィールドを同じ検索式に並べて、段階的に結果を絞り込める。</>
            ) : (
              <>欄位語法固定使用 <code>COLUMN:QUERY</code>。不同欄位可以放在同一條搜尋式中，逐步縮小結果。</>
            )}
          </p>
          <div class="obj-filter-formula">
            <code>^Construct scale:0 static:1</code>
            <span>{lang === "ja" ? "名前が一致 + ワールドレベルで変化しない + 固定配置" : "名稱開頭符合 + 不隨世界等級變化 + Static 固定物件"}</span>
          </div>
        </div>

        {/* 鍵帽牆＋檢視面板：欄位橫向排列一眼可見，說明固定顯示在下方面板。
            面板內容由 JS 從鍵帽自身的 data-* 換入，無 JS 時仍會顯示第一個欄位。 */}
        <div class="obj-filter-board">
          <div class="obj-filter-keys" role="tablist" aria-label={lang === "ja" ? "フィールド絞り込み" : "欄位篩選"}>
            {fieldFilters.map((item, index) => (
              <button
                type="button"
                role="tab"
                id={`objkey-${item.field}`}
                aria-controls="obj-filter-detail"
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-field={item.field}
                data-use={lang === "ja" ? item.useJa : item.use}
                data-value={item.value}
              >
                {item.field}:
              </button>
            ))}
          </div>

          <div
            class="obj-filter-detail"
            id="obj-filter-detail"
            role="tabpanel"
            aria-labelledby={`objkey-${fieldFilters[0].field}`}
          >
            <p>
              <code data-detail="field">{fieldFilters[0].field}:</code>
              <span data-detail="use">{lang === "ja" ? fieldFilters[0].useJa : fieldFilters[0].use}</span>
            </p>
            <div>
              <span>{lang === "ja" ? "例" : "範例"}</span>
              <code data-detail="example">{fieldFilters[0].field}:{fieldFilters[0].value}</code>
              <button type="button" data-copy={`${fieldFilters[0].field}:${fieldFilters[0].value}`}>
                <span>{lang === "ja" ? "コピー" : "複製"}</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="tools" class="obj-section obj-reveal">
      <div class="obj-wrap">
        <div class="obj-section-heading">
          <span>{lang === "ja" ? "MAP WORKFLOW · マップツール" : "MAP WORKFLOW · 地圖工具"}</span>
          <h2>{lang === "ja" ? "地図上での見え方" : "顯示物件資訊"}</h2>
        </div>

        <div class="obj-tools-list">
          {mapTools.map((tool) => (
            <article>
              <span>{tool.no}</span>
              <h3>{tool.title}</h3>
              <p>{lang === "ja" ? tool.textJa : tool.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="notes" class="obj-section obj-section-notes obj-reveal">
      <div class="obj-wrap obj-notes-layout">
        <div>
          <span class="obj-note-mark">FIELD NOTES</span>
          <h2>{lang === "ja" ? "利用前の注意" : "使用前注意"}</h2>
        </div>
        <ul>
          {lang === "ja" ? (
            <>
              <li>オブジェクトマップは未探索エリア、内部名称、クエストオブジェクトも表示するため、ストーリーや探索のネタバレを含む場合がある。</li>
              <li>検索結果には既定の表示件数の上限がある。条件が広すぎる場合は、フィールドやキーワードを追加して再検索すること。</li>
              <li>名前にスペースや特殊文字が含まれる場合は、名前全体をダブルクォートで囲むこと。例：<code>"Soldier Construct"</code>。</li>
              <li>ティアキン版で使えるフィールドは上記の 6 個のみ。ブレワイ版にしかない <code>hard:</code>、<code>equip:</code>、<code>drop:</code> などのフィールドはここでは検索式を解析できないと表示される。</li>
              <li>天空・地表・地底は独立した 3 つのレイヤーで、画面上のレイヤー切り替えでは検索範囲は変わらない。範囲を限定するには <code>map:</code> で Surface／Depths／Sky を指定すること。</li>
            </>
          ) : (
            <>
              <li>物件地圖會顯示未探索地區、內部名稱與任務物件，可能包含劇情或探索上的雷。</li>
              <li>搜尋結果預設有顯示數量上限；條件太寬時，請加入欄位或關鍵字再搜尋。</li>
              <li>名稱中含有空格或特殊字元時，請用雙引號包住整個名稱，例如 <code>"Soldier Construct"</code>。</li>
              <li>王淚版可用的欄位只有上方列出的 6 個；曠野版才有的 <code>hard:</code>、<code>equip:</code>、<code>drop:</code> 等欄位在這裡會直接回報無法解析搜尋式。</li>
              <li>天空、地表與地底是三個獨立圖層，畫面上的圖層切換不會改變搜尋範圍；要限定範圍請用 <code>map:</code> 指定 Surface／Depths／Sky。</li>
            </>
          )}
        </ul>
      </div>
    </section>

    <section class="obj-final-cta obj-reveal">
      <div class="obj-wrap">
        <span>READY TO SEARCH</span>
        <h2>{lang === "ja" ? "ハイラル探索をはじめよう" : "開始探索海拉魯"}</h2>
        <a href={MAP_URL} target="_blank" rel="noopener">
          {lang === "ja" ? "ティアキンのオブジェクトマップを開く" : "開啟王淚物件地圖"}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 5h5v5M19 5l-8 8M18 13v5a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
          </svg>
        </a>
      </div>
    </section>
  </div>

  <style>
    .obj-guide {
      --guide-line: color-mix(in srgb, var(--accent) 42%, var(--border-strong));
      --hero-base: var(--surface);
      --hero-ink: var(--ink);
      --hero-ink-soft: color-mix(in srgb, var(--ink) 80%, transparent);
      --hero-ink-muted: color-mix(in srgb, var(--ink) 56%, transparent);
      --hero-accent: var(--brand);
      --hero-frame: color-mix(in srgb, var(--ink) 12%, transparent);
      --hero-overlay:
        linear-gradient(
          to bottom,
          color-mix(in srgb, var(--surface) 96%, transparent) 0%,
          color-mix(in srgb, var(--surface) 68%, transparent) 16%,
          color-mix(in srgb, var(--bg) 12%, transparent) 46%,
          color-mix(in srgb, var(--bg) 54%, transparent) 78%,
          var(--bg) 100%
        ),
        linear-gradient(
          90deg,
          color-mix(in srgb, var(--surface) 88%, transparent) 0%,
          color-mix(in srgb, var(--surface) 62%, transparent) 44%,
          color-mix(in srgb, var(--surface) 20%, transparent) 100%
        );
      --hero-map-opacity: 0.6;
      --hero-map-filter: saturate(0.42) contrast(0.96) brightness(1.12);
      --hero-canvas-height: calc(min(620px, calc(100svh - 120px)) + 55px);
      --hero-nav-bg: linear-gradient(
        to bottom,
        color-mix(in srgb, var(--bg) 78%, transparent),
        var(--bg)
      );
      overflow: clip;
    }

    :global([data-theme="dark"]) .obj-guide {
      --hero-base: #161917;
      --hero-ink: #f6f6f4;
      --hero-ink-soft: rgba(246, 246, 244, 0.82);
      --hero-ink-muted: rgba(246, 246, 244, 0.56);
      --hero-accent: #5fd7e4;
      --hero-frame: rgba(246, 246, 244, 0.18);
      --hero-overlay: color-mix(in srgb, #121413 74%, transparent);
      --hero-map-opacity: 1;
      --hero-map-filter: saturate(0.72) contrast(1.08) brightness(0.72);
      --hero-nav-bg: var(--bg);
    }

    .obj-wrap,
    .obj-hero-inner,
    .obj-section-nav-inner {
      width: min(1180px, calc(100% - 64px));
      margin-inline: auto;
    }

    .obj-hero-shell {
      position: relative;
      isolation: isolate;
      overflow: clip;
    }

    .obj-hero-shell::after {
      content: "";
      position: absolute;
      inset: 18px 18px 0;
      border: 1px solid var(--hero-frame);
      /* 只留左右兩道內框線當裝飾；上下都不畫——上緣本來就離導覽列很近，
         一條橫線在那裡很容易被誤認成導覽列自己的邊框或殘留線。 */
      border-top: 0;
      border-bottom: 0;
      pointer-events: none;
      z-index: 31;
    }

    .obj-hero-canvas {
      position: absolute;
      inset: 0 0 auto;
      z-index: 0;
      height: var(--hero-canvas-height);
      overflow: hidden;
      pointer-events: none;
      background: var(--hero-base);
    }

    .obj-hero {
      position: relative;
      height: min(620px, calc(100svh - 120px));
      min-height: 480px;
      overflow: hidden;
      background: transparent;
      color: var(--hero-ink);
      isolation: isolate;
      transition: color 240ms ease;
    }

    .obj-hero-map,
    .obj-hero-shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .obj-hero-map {
      object-fit: cover;
      object-position: center;
      filter: var(--hero-map-filter);
      opacity: var(--hero-map-opacity);
      transform: scale(1.035);
      animation: obj-map-settle 1.1s cubic-bezier(0.16, 1, 0.3, 1) both;
    }

    .obj-hero-shade {
      background: var(--hero-overlay);
      z-index: 1;
    }

    .obj-hero-inner {
      position: relative;
      z-index: 4;
      height: 100%;
      display: flex;
      flex-direction: column;
      padding-block: 28px 42px;
    }

    .obj-breadcrumb {
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      color: var(--hero-ink-muted);
    }

    .obj-breadcrumb a {
      color: inherit;
      text-decoration: none;
    }

    .obj-breadcrumb a:hover {
      color: var(--hero-ink);
    }

    .obj-hero-content {
      max-width: 720px;
      margin-block: auto;
      padding-block: 24px;
    }

    .obj-kicker {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      color: #5fd7e4;
      font-family: var(--font-mono);
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 1.4px;
      text-transform: uppercase;
    }

    .obj-kicker svg {
      width: 22px;
      height: 22px;
      fill: currentColor;
    }

    .obj-hero h1 {
      max-width: none;
      margin: 0;
      font-family: var(--font-heading);
      font-size: 44px;
      font-weight: 500;
      line-height: 1.08;
      letter-spacing: 0;
      white-space: nowrap;
      opacity: 0;
      transform: translateY(18px);
      animation: obj-rise 0.72s 0.12s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .obj-hero-content > p {
      max-width: 41rem;
      margin: 22px 0 0;
      color: var(--hero-ink-soft);
      font-size: 17px;
      line-height: 1.85;
      opacity: 0;
      transform: translateY(14px);
      animation: obj-rise 0.68s 0.24s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    .obj-hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      margin-top: 22px;
      font-family: var(--font-mono);
      font-size: 10px;
      color: var(--hero-ink-muted);
      text-transform: uppercase;
    }

    .obj-hero-meta span + span::before {
      content: "/";
      margin-right: 18px;
      color: var(--hero-accent);
    }

    .obj-hero-actions {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px 22px;
      margin-top: 30px;
    }

    .obj-primary-action,
    .obj-final-cta a {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 0 20px;
      background: var(--ink);
      color: var(--bg);
      border: 1px solid var(--ink);
      border-radius: 5px;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      transition: background-color 180ms, border-color 180ms, transform 120ms;
    }

    .obj-primary-action svg,
    .obj-final-cta svg {
      width: 17px;
      height: 17px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .obj-primary-action:hover,
    .obj-final-cta a:hover {
      background: var(--ink-2);
      border-color: var(--ink-2);
    }

    .obj-primary-action:active,
    .obj-final-cta a:active {
      transform: translateY(1px);
    }

    .obj-secondary-action {
      padding-block: 12px;
      color: var(--hero-ink-soft);
      font-size: 14px;
      text-underline-offset: 4px;
    }

    .obj-coordinate {
      position: absolute;
      right: 0;
      bottom: 42px;
      display: grid;
      gap: 3px;
      min-width: 158px;
      padding-left: 16px;
      border-left: 1px solid color-mix(in srgb, var(--hero-ink) 24%, transparent);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1px;
      color: var(--hero-ink-muted);
      text-align: left;
    }

    .obj-coordinate strong {
      color: var(--hero-accent);
      font-size: 11px;
      font-weight: 500;
    }

    .obj-scan {
      position: absolute;
      top: 50%;
      right: 17%;
      width: 260px;
      height: 260px;
      transform: translate(50%, -50%);
      z-index: 3;
      pointer-events: none;
    }

    .obj-scan-ring,
    .obj-scan-cross,
    .obj-scan-dot {
      position: absolute;
      display: block;
    }

    .obj-scan-ring {
      inset: 0;
      border: 1px solid color-mix(in srgb, var(--hero-accent) 42%, transparent);
      border-radius: 50%;
      animation: obj-scan-pulse 3.2s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    }

    .obj-scan-ring-b {
      inset: 52px;
      animation-delay: 0.9s;
    }

    .obj-scan-cross-x {
      top: 50%;
      left: -32px;
      width: calc(100% + 64px);
      height: 1px;
      background: color-mix(in srgb, var(--hero-accent) 32%, transparent);
    }

    .obj-scan-cross-y {
      left: 50%;
      top: -32px;
      width: 1px;
      height: calc(100% + 64px);
      background: color-mix(in srgb, var(--hero-accent) 32%, transparent);
    }

    .obj-scan-dot {
      left: 50%;
      top: 50%;
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--hero-accent);
      box-shadow: 0 0 0 5px color-mix(in srgb, var(--hero-accent) 18%, transparent);
      transform: translate(-50%, -50%);
    }

    .obj-section-nav {
      position: sticky;
      top: 64px;
      z-index: 30;
      border-bottom: 1px solid var(--border-strong);
      background: var(--hero-nav-bg);
    }

    .obj-section-nav-inner {
      display: flex;
      min-height: 54px;
      align-items: center;
      gap: 24px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .obj-section-nav-inner::-webkit-scrollbar {
      display: none;
    }

    .obj-section-nav-label {
      margin-right: auto;
      color: var(--gold);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 1.3px;
      white-space: nowrap;
    }

    .obj-section-nav a {
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      color: var(--muted);
      font-size: 12px;
      text-decoration: none;
      white-space: nowrap;
      transition: color 160ms;
    }

    .obj-section-nav a:hover,
    .obj-section-nav a:focus-visible {
      color: var(--ink);
    }

    .obj-section {
      padding-block: 88px;
      scroll-margin-top: 118px;
    }

    .obj-section + .obj-section {
      border-top: 1px solid var(--border-soft);
    }

    .obj-section-heading > span,
    .obj-note-mark,
    .obj-final-cta > .obj-wrap > span {
      color: var(--gold);
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 1.6px;
      text-transform: uppercase;
    }

    .obj-section-heading h2,
    .obj-section-notes h2,
    .obj-final-cta h2 {
      margin: 12px 0 0;
      color: var(--ink);
      font-family: var(--font-heading);
      font-size: 34px;
      font-weight: 500;
      line-height: 1.28;
      letter-spacing: 0;
    }

    .obj-start-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0;
      margin-top: 48px;
      border-block: 1px solid var(--border-strong);
    }

    .obj-start-grid article {
      position: relative;
      min-width: 0;
      padding: 32px 36px 34px 0;
    }

    .obj-start-grid article + article {
      padding-left: 36px;
      border-left: 1px solid var(--border-strong);
    }

    .obj-step-no {
      color: var(--gold);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .obj-start-grid h3,
    .obj-tools-list h3 {
      margin: 13px 0 0;
      color: var(--ink);
      font-family: var(--font-heading);
      font-size: 20px;
      font-weight: 500;
    }

    .obj-start-grid p,
    .obj-tools-list p {
      margin: 10px 0 18px;
      color: var(--text);
      font-size: 14px;
      line-height: 1.75;
    }

    code {
      font-family: var(--font-mono);
      font-variant-ligatures: none;
    }

    .obj-filter-formula code {
      color: var(--accent);
      font-size: 12px;
    }

    .obj-inline-link {
      color: var(--accent);
      text-underline-offset: 2px;
    }

    .obj-inline-link:hover {
      text-decoration-thickness: 2px;
    }

    /* 每張卡片的範例：程式碼＋備註成對，之後要補多組範例時直接往容器裡加 */
    .obj-step-examples {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .obj-step-example {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }

    .obj-step-example code {
      color: var(--accent);
      font-size: 12px;
    }

    .obj-step-example span {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.6;
    }

    .obj-section-lab {
      background: var(--surface);
    }

    .obj-lab-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
      gap: 72px;
      align-items: center;
    }

    .obj-lab-copy > p,
    .obj-filter-intro > p {
      max-width: 58ch;
      margin: 22px 0 0;
      color: var(--text);
      font-size: 15px;
      line-height: 1.85;
    }

    .obj-lab-copy p code,
    .obj-section-notes code {
      color: var(--accent);
      font-size: 0.9em;
    }

    .obj-query-output {
      position: relative;
      margin-top: 32px;
      min-height: 146px;
      padding: 22px 24px 20px;
      border: 1px solid var(--guide-line);
      background: var(--mono-bg);
      border-radius: 5px;
    }

    .obj-query-output::before,
    .obj-query-output::after {
      content: "";
      position: absolute;
      width: 18px;
      height: 18px;
      border-color: var(--accent);
      pointer-events: none;
    }

    .obj-query-output::before {
      top: -1px;
      left: -1px;
      border-top: 2px solid;
      border-left: 2px solid;
    }

    .obj-query-output::after {
      right: -1px;
      bottom: -1px;
      border-right: 2px solid;
      border-bottom: 2px solid;
    }

    .obj-query-output > span,
    .obj-control-label {
      display: block;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 9px;
      letter-spacing: 1.2px;
    }

    .obj-query-output > code {
      display: block;
      min-height: 38px;
      margin-top: 11px;
      color: var(--mono-text);
      font-size: 18px;
      line-height: 1.6;
      overflow-wrap: anywhere;
    }

    .obj-query-output > code.is-placeholder {
      color: var(--muted);
      font-style: italic;
    }

    .obj-query-output button {
      display: inline-flex;
      min-height: 40px;
      align-items: center;
      gap: 8px;
      margin-top: 14px;
      padding: 0 12px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: var(--surface);
      color: var(--ink);
      font-size: 12px;
      cursor: pointer;
      transition: border-color 160ms, color 160ms;
    }

    .obj-query-output button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .obj-query-output button svg,
    .obj-copy-icon svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
    }

    .obj-query-controls {
      border-top: 1px solid var(--border-strong);
    }

    .obj-query-controls > div,
    .obj-token {
      width: 100%;
      min-height: 68px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 12px 4px;
      border: 0;
      border-bottom: 1px solid var(--border-strong);
      background: transparent;
      text-align: left;
    }

    .obj-token {
      color: var(--text);
      cursor: pointer;
      transition: color 160ms, padding-left 180ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .obj-token:hover,
    .obj-token[aria-pressed="true"] {
      color: var(--ink);
      padding-left: 10px;
    }

    .obj-token[aria-pressed="true"] {
      box-shadow: inset 3px 0 var(--ink);
    }

    .obj-query-controls code {
      flex: none;
      color: var(--accent);
      font-size: 11px;
    }

    /* 取代原本固定顯示關鍵字的 code：改成可選的下拉選單，
       視覺上比照同一列右側 code chip 的字體與強調色 */
    .obj-base-select {
      flex: none;
      padding: 4px 10px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: var(--surface);
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
      transition: border-color 160ms, color 160ms;
    }

    .obj-base-select:hover,
    .obj-base-select:focus-visible {
      border-color: var(--accent);
    }

    .obj-token span {
      font-size: 13px;
    }

    .obj-heading-row {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 40px;
    }

    .obj-heading-row > p {
      max-width: 31ch;
      margin: 0 0 5px;
      color: var(--muted);
      font-size: 13px;
      line-height: 1.7;
    }

    .obj-recipe-list {
      margin-top: 46px;
      border-top: 1px solid var(--border-strong);
    }

    .obj-recipe {
      display: grid;
      grid-template-columns: 120px minmax(210px, 0.8fr) minmax(0, 1.2fr) 44px;
      gap: 24px;
      align-items: center;
      min-height: 76px;
      border-bottom: 1px solid var(--border-strong);
    }

    .obj-recipe-label {
      color: var(--muted);
      font-size: 12px;
    }

    .obj-recipe > code {
      color: var(--ink);
      font-size: 13px;
      overflow-wrap: anywhere;
    }

    .obj-recipe > p {
      margin: 0;
      color: var(--text);
      font-size: 13px;
      line-height: 1.6;
    }

    .obj-copy-icon {
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      border: 0;
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      cursor: pointer;
      transition: color 160ms, background-color 160ms;
    }

    .obj-copy-icon:hover,
    .obj-copy-icon[data-copied="true"] {
      color: var(--accent);
      background: var(--sand);
    }

    .obj-section-filters {
      background: var(--surface);
    }

    .obj-filter-layout {
      display: grid;
      grid-template-columns: minmax(0, 0.78fr) minmax(420px, 1.22fr);
      gap: 84px;
      align-items: start;
    }

    .obj-filter-intro {
      position: sticky;
      top: 150px;
    }

    .obj-filter-formula {
      display: grid;
      gap: 8px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border-strong);
    }

    .obj-filter-formula span {
      color: var(--muted);
      font-size: 11px;
    }

    .obj-filter-board {
      display: grid;
      gap: 22px;
    }

    .obj-filter-keys {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .obj-filter-keys button {
      min-height: 38px;
      padding: 0 14px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      font-family: inherit;
      font-size: 12px;
      cursor: pointer;
      transition:
        border-color 180ms cubic-bezier(0.65, 0, 0.35, 1),
        background-color 180ms cubic-bezier(0.65, 0, 0.35, 1),
        color 180ms cubic-bezier(0.65, 0, 0.35, 1);
    }

    .obj-filter-keys button:hover {
      border-color: color-mix(in srgb, var(--accent) 55%, var(--border-strong));
      color: var(--ink);
    }

    /* 選中鍵帽：走全站的「墨＝你在這裡」，跟術語表／主題頁的篩選鈕同一套。
       原本填 accent 藍，是這次色彩角色掃描漏掉的一處；改用 ink 之後
       也不再需要 --key-on-bg／--key-on-ink 那組隨主題翻轉的變數——
       那組變數存在的唯一理由就是「把藍色壓到夠有對比」。 */
    .obj-filter-keys button[aria-selected="true"] {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--bg);
    }

    .obj-filter-detail {
      display: grid;
      gap: 16px;
      padding: 22px 20px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: var(--bg);
    }

    .obj-filter-detail > p {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 6px 12px;
      margin: 0;
    }

    .obj-filter-detail > p code {
      color: var(--accent);
      font-size: 12px;
    }

    .obj-filter-detail > p span {
      color: var(--text);
      font-size: 13px;
    }

    .obj-filter-detail > div {
      display: grid;
      grid-template-columns: 42px minmax(0, 1fr) auto;
      gap: 14px;
      align-items: center;
      padding-top: 16px;
      border-top: 1px solid var(--border-strong);
    }

    .obj-filter-detail > div > span {
      color: var(--muted);
      font-size: 11px;
    }

    .obj-filter-detail > div code {
      color: var(--ink);
      font-size: 12px;
      overflow-wrap: anywhere;
    }

    .obj-filter-detail > div button {
      min-width: 56px;
      min-height: 38px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: transparent;
      color: var(--muted);
      font-size: 11px;
      cursor: pointer;
    }

    .obj-filter-detail > div button:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .obj-tools-list {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      margin-top: 48px;
      border-block: 1px solid var(--border-strong);
    }

    .obj-tools-list article {
      display: grid;
      grid-template-columns: 54px 130px 1fr;
      gap: 20px;
      align-items: start;
      padding: 30px 28px 30px 0;
    }

    .obj-tools-list article:nth-child(even) {
      padding-left: 28px;
      border-left: 1px solid var(--border-strong);
    }

    .obj-tools-list article:nth-child(n + 3) {
      border-top: 1px solid var(--border-strong);
    }

    .obj-tools-list article > span {
      color: var(--gold);
      font-family: var(--font-mono);
      font-size: 11px;
    }

    .obj-tools-list h3,
    .obj-tools-list p {
      margin: 0;
    }

    .obj-section-notes {
      background: var(--mono-bg);
    }

    .obj-notes-layout {
      display: grid;
      grid-template-columns: minmax(220px, 0.65fr) minmax(0, 1.35fr);
      gap: 80px;
    }

    .obj-section-notes ul {
      margin: 0;
      padding: 0;
      list-style: none;
      border-top: 1px solid var(--border-strong);
    }

    .obj-section-notes li {
      position: relative;
      padding: 17px 8px 17px 28px;
      border-bottom: 1px solid var(--border-strong);
      color: var(--text);
      font-size: 13px;
      line-height: 1.75;
    }

    .obj-section-notes li::before {
      content: "";
      position: absolute;
      left: 4px;
      top: 25px;
      width: 7px;
      height: 7px;
      border: 1px solid var(--accent);
      transform: rotate(45deg);
    }

    .obj-final-cta {
      padding-block: 86px;
      border-top: 1px solid var(--border-soft);
    }

    .obj-final-cta .obj-wrap {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 12px 48px;
    }

    .obj-final-cta > .obj-wrap > span {
      grid-column: 1;
    }

    .obj-final-cta h2 {
      grid-column: 1;
      margin-top: 0;
    }

    .obj-final-cta a {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .obj-reveal {
      opacity: 0;
      transform: translateY(20px);
      transition: opacity 620ms cubic-bezier(0.16, 1, 0.3, 1), transform 620ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .obj-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .obj-guide :is(a, button, summary):focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
    }

    @keyframes obj-map-settle {
      from { opacity: 0; transform: scale(1.09); }
      to { opacity: 1; transform: scale(1.035); }
    }

    @keyframes obj-rise {
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes obj-scan-pulse {
      0% { opacity: 0; transform: scale(0.58); }
      42% { opacity: 1; }
      100% { opacity: 0; transform: scale(1); }
    }

    @media (max-width: 960px) {
      .obj-scan {
        right: 8%;
        opacity: 0.62;
      }

      .obj-lab-layout,
      .obj-filter-layout {
        grid-template-columns: 1fr;
        gap: 48px;
      }

      .obj-filter-intro {
        position: static;
      }

      .obj-tools-list article {
        grid-template-columns: 40px 112px 1fr;
      }
    }

    @media (max-width: 760px) {
      /* Hero 高度原本設 560px/最小 470px，內容區塊又用 margin-block:auto 置中，
         兩者疊加在窄螢幕上留下大片看得到但沒東西的地圖背景。收窄容器高度，
         讓置中後的留白貼近內容本身的份量。 */
      .obj-guide {
        --hero-canvas-height: calc(min(420px, calc(100svh - 96px)) + 55px);
      }

      .obj-wrap,
      .obj-hero-inner,
      .obj-section-nav-inner {
        width: min(100% - 40px, 1180px);
      }

      .obj-hero {
        height: min(420px, calc(100svh - 96px));
        min-height: 380px;
      }

      .obj-hero-shell::after {
        inset: 10px 10px 0;
      }

      .obj-hero-inner {
        padding-block: 20px 16px;
      }

      /* 原本這裡疊加了 padding-top:52px，跟 margin-block:auto 的置中效果
         互相加成，是留白過寬的主因，移除後交給置中自然分配上下空間。
         下緣特意比上緣窄：置中留白本身上下相等，但內容自己的
         padding-block（基礎規則 24px／24px）+ 這層容器的下內距
         會疊加在下緣，天生比上緣多兩層，所以這裡刻意把下內距壓低、
         再把內容自身的下內距單獨蓋掉，兩緣才不會差太多 */
      .obj-hero-content {
        padding-block: 24px 8px;
      }

      .obj-hero h1 {
        max-width: none;
        font-size: clamp(23px, 7vw, 34px);
        white-space: nowrap;
      }

      .obj-hero-content > p {
        max-width: 30ch;
        margin-top: 16px;
        font-size: 14px;
        line-height: 1.75;
      }

      .obj-hero-meta,
      .obj-coordinate {
        display: none;
      }

      .obj-hero-actions {
        margin-top: 22px;
      }

      .obj-primary-action {
        min-height: 46px;
        padding-inline: 16px;
      }

      .obj-scan {
        top: 28%;
        right: -34px;
        width: 190px;
        height: 190px;
      }

      .obj-section-nav {
        top: 58px;
      }

      .obj-section-nav-label {
        display: none;
      }

      .obj-section-nav-inner {
        gap: 22px;
      }

      .obj-section {
        padding-block: 62px;
        scroll-margin-top: 112px;
      }

      .obj-section-heading h2,
      .obj-section-notes h2,
      .obj-final-cta h2 {
        font-size: 26px;
      }

      .obj-start-grid {
        grid-template-columns: 1fr;
        margin-top: 34px;
      }

      .obj-start-grid article,
      .obj-start-grid article + article {
        padding: 26px 0;
        border-left: 0;
      }

      .obj-start-grid article + article {
        border-top: 1px solid var(--border-strong);
      }

      .obj-heading-row {
        align-items: start;
        flex-direction: column;
        gap: 16px;
      }

      .obj-recipe {
        grid-template-columns: minmax(0, 1fr) 44px;
        gap: 8px 12px;
        padding-block: 18px;
      }

      .obj-recipe-label,
      .obj-recipe > code,
      .obj-recipe > p {
        grid-column: 1;
      }

      .obj-recipe-label {
        font-size: 10px;
      }

      .obj-copy-icon {
        grid-column: 2;
        grid-row: 1 / span 3;
      }

      /* 鍵帽是這區主要的點擊目標，窄螢幕放大到建議的 44px 觸控高度 */
      .obj-filter-keys button {
        min-height: 44px;
      }

      /* 窄螢幕把「範例」標籤挪到自己一行，讓查詢字串有完整寬度不被擠斷 */
      .obj-filter-detail > div {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 8px 12px;
      }

      .obj-filter-detail > div > span {
        grid-column: 1 / -1;
      }

      .obj-tools-list {
        grid-template-columns: 1fr;
      }

      .obj-tools-list article,
      .obj-tools-list article:nth-child(even) {
        grid-template-columns: 36px 1fr;
        gap: 8px 14px;
        padding: 25px 0;
        border-left: 0;
      }

      .obj-tools-list article + article {
        border-top: 1px solid var(--border-strong);
      }

      .obj-tools-list article > span {
        grid-row: 1 / span 2;
      }

      .obj-tools-list h3,
      .obj-tools-list p {
        grid-column: 2;
      }

      .obj-notes-layout {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .obj-final-cta {
        padding-block: 64px;
      }

      .obj-final-cta .obj-wrap {
        grid-template-columns: 1fr;
        align-items: start;
        gap: 14px;
      }

      .obj-final-cta > .obj-wrap > span,
      .obj-final-cta h2,
      .obj-final-cta a {
        grid-column: 1;
        grid-row: auto;
      }

      .obj-final-cta a {
        margin-top: 10px;
      }
    }

    @media (max-width: 380px) {
      /* 100% - 28px 兩側各留 14px，太貼邊緣；32px 讓兩側各多 2px 呼吸空間 */
      .obj-wrap,
      .obj-hero-inner,
      .obj-section-nav-inner {
        width: min(100% - 32px, 1180px);
      }

      .obj-kicker {
        font-size: 9px;
        letter-spacing: 0.9px;
      }

      .obj-hero h1 {
        font-size: 24px;
      }

      .obj-secondary-action {
        width: 100%;
      }

      .obj-query-output > code {
        font-size: 15px;
      }

      .obj-query-controls > div,
      .obj-token {
        align-items: flex-start;
        flex-direction: column;
        gap: 6px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .obj-hero-map,
      .obj-hero h1,
      .obj-hero-content > p,
      .obj-scan-ring {
        animation: none;
        opacity: 1;
        transform: none;
      }

      .obj-reveal {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  </style>

  <script>
    const tokenButtons = Array.from(document.querySelectorAll<HTMLButtonElement>(".obj-token"));
    const queryOutput = document.getElementById("query-output");
    const baseSelect = document.getElementById("query-base") as HTMLSelectElement | null;
    // .obj-lab-layout 在 960px 斷點以下會從左右並排改成上下堆疊（見對應的
    // @media (max-width: 960px) 規則），條件按鈕從「右側」變成「下方」，
    // 提示文字要跟著同一個斷點換方向用詞，不然窄螢幕會出現「請點擊右側內容」
    // 但右側其實什麼都沒有的錯誤指示
    const stackedQuery = window.matchMedia("(max-width: 960px)");
    const isJa = document.documentElement.lang === "ja";
    // 還沒選基本關鍵字、也沒點任何條件時顯示的提示文字
    function queryPlaceholderText() {
      if (isJa) return stackedQuery.matches ? "下の内容をクリック" : "右側の内容をクリック";
      return stackedQuery.matches ? "請點擊下方內容" : "請點擊右側內容";
    }

    function updateQuery() {
      const tokens = tokenButtons
        .filter((button) => button.getAttribute("aria-pressed") === "true")
        .map((button) => button.dataset.queryToken)
        .filter(Boolean);
      const base = baseSelect?.value ?? "";
      const parts = [base, ...tokens].filter(Boolean);
      if (!queryOutput) return;
      if (parts.length === 0) {
        queryOutput.textContent = queryPlaceholderText();
        queryOutput.classList.add("is-placeholder");
      } else {
        queryOutput.textContent = parts.join(" ");
        queryOutput.classList.remove("is-placeholder");
      }
    }

    // 頁面載入時先跑一次，把 SSR 輸出的預設文字校正成目前實際視窗寬度該顯示的版本
    updateQuery();
    stackedQuery.addEventListener("change", updateQuery);

    baseSelect?.addEventListener("change", updateQuery);

    tokenButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const active = button.getAttribute("aria-pressed") === "true";
        button.setAttribute("aria-pressed", String(!active));
        updateQuery();
      });
    });

    async function copyText(text: string, button: HTMLElement) {
      try {
        await navigator.clipboard.writeText(text);
        button.dataset.copied = "true";
        const label = button.querySelector("span");
        const previous = label?.textContent;
        if (label) label.textContent = isJa ? "コピー済み" : "已複製";
        window.setTimeout(() => {
          delete button.dataset.copied;
          if (label && previous) label.textContent = previous;
        }, 1600);
      } catch {
        button.dataset.copied = "false";
      }
    }

    document.querySelectorAll<HTMLElement>("[data-copy]").forEach((button) => {
      button.addEventListener("click", () => copyText(button.dataset.copy ?? "", button));
    });

    document.querySelectorAll<HTMLElement>("[data-copy-target]").forEach((button) => {
      button.addEventListener("click", () => {
        const target = document.getElementById(button.dataset.copyTarget ?? "");
        if (target?.classList.contains("is-placeholder")) return; // 還沒選內容，不複製提示文字
        if (target?.textContent) copyText(target.textContent, button);
      });
    });

    // 欄位鍵帽牆：選取狀態 + 檢視面板換內容。採 roving tabindex，
    // 整組鍵帽在 Tab 順序裡只佔一站，進去後用方向鍵移動（ARIA tablist 慣例）。
    const filterKeys = Array.from(
      document.querySelectorAll<HTMLButtonElement>(".obj-filter-keys button"),
    );
    const filterDetail = document.getElementById("obj-filter-detail");

    if (filterKeys.length > 0 && filterDetail) {
      const fieldOut = filterDetail.querySelector<HTMLElement>('[data-detail="field"]');
      const useOut = filterDetail.querySelector<HTMLElement>('[data-detail="use"]');
      const exampleOut = filterDetail.querySelector<HTMLElement>('[data-detail="example"]');
      const detailCopy = filterDetail.querySelector<HTMLElement>("[data-copy]");

      const selectFilterKey = (index: number, moveFocus: boolean) => {
        const key = filterKeys[index];
        if (!key) return;

        filterKeys.forEach((button) => {
          const isOn = button === key;
          button.setAttribute("aria-selected", isOn ? "true" : "false");
          button.tabIndex = isOn ? 0 : -1;
        });

        const query = `${key.dataset.field ?? ""}:${key.dataset.value ?? ""}`;
        if (fieldOut) fieldOut.textContent = `${key.dataset.field ?? ""}:`;
        if (useOut) useOut.textContent = key.dataset.use ?? "";
        if (exampleOut) exampleOut.textContent = query;
        // 複製鈕的監聽器是在點擊當下才讀 data-copy，改屬性就會跟著換
        if (detailCopy) detailCopy.dataset.copy = query;
        filterDetail.setAttribute("aria-labelledby", key.id);

        if (moveFocus) key.focus();
      };

      filterKeys.forEach((key, index) => {
        key.addEventListener("click", () => selectFilterKey(index, false));
        key.addEventListener("keydown", (event) => {
          const step =
            event.key === "ArrowRight" || event.key === "ArrowDown"
              ? 1
              : event.key === "ArrowLeft" || event.key === "ArrowUp"
                ? -1
                : 0;

          if (step !== 0) {
            event.preventDefault();
            selectFilterKey((index + step + filterKeys.length) % filterKeys.length, true);
          } else if (event.key === "Home") {
            event.preventDefault();
            selectFilterKey(0, true);
          } else if (event.key === "End") {
            event.preventDefault();
            selectFilterKey(filterKeys.length - 1, true);
          }
        });
      });
    }

    const revealItems = document.querySelectorAll<HTMLElement>(".obj-reveal");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.12 }
      );
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }
  </script>
</BaseLayout>
