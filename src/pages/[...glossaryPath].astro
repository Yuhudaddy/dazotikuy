---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { GAME_LOGOS } from "../data/gameLogos";
import { glossaryEntries, glossaryFamilies, glossaryGames } from "../data/glossary";
import { uiStrings, type Lang } from "../data/ui-strings";

// 中文 /types/glossary、日文 /ja/types/glossary
export function getStaticPaths() {
  return [
    { params: { glossaryPath: "types/glossary" }, props: { lang: "zh" as Lang } },
    { params: { glossaryPath: "ja/types/glossary" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];

const tagOf = (id: string) => glossaryGames.find((game) => game.id === id)?.tag ?? id;

// 分組鍵：英數開頭歸該字母，中文等其他開頭一律歸「#」放最後
const groupKey = (abbr: string) => {
  const head = abbr.trim().charAt(0).toUpperCase();
  return /[A-Z]/.test(head) ? head : "#";
};

const sorted = [...glossaryEntries].sort((a, b) => {
  const ka = groupKey(a.abbr);
  const kb = groupKey(b.abbr);
  if (ka !== kb) return ka === "#" ? 1 : kb === "#" ? -1 : ka.localeCompare(kb);
  const locale = ka === "#" ? "zh-Hant" : "en";
  return a.abbr.localeCompare(b.abbr, locale, { sensitivity: "base" });
});

const groups = [...new Set(sorted.map((entry) => groupKey(entry.abbr)))].map((letter) => ({
  letter,
  anchor: letter === "#" ? "zh" : letter,
  items: sorted.filter((entry) => groupKey(entry.abbr) === letter),
}));

// 別名與家族名不顯示在頁面上，但仍寫進搜尋索引，讓使用者打「隱藏」或別名也能找到
const searchIndex = (entry: (typeof glossaryEntries)[number]) =>
  [
    entry.abbr,
    entry.en,
    entry.ja,
    entry.zh,
    entry.description,
    entry.family ? glossaryFamilies[entry.family] : null,
    ...(entry.aliases ?? []),
  ]
    .filter(Boolean)
    .join(" ")
    .toLowerCase();
---

<BaseLayout
  title={t.typesGlossaryLink}
  description={t.glossaryDescription}
  active="types"
  lang={lang}
  altPath="/types/glossary"
>
  <section class="border-b border-border-soft">
    <div class="glossary-hero mx-auto max-w-[1244px] px-8 pb-11 pt-[52px]" data-glossary-hero data-active-game="all">
      <div class="glossary-copy relative z-[1]">
        <div class="mb-[22px] flex items-center gap-2.5 text-[13px] text-muted">
          <a href={href("/home", lang)} class="no-underline text-muted">{t.breadcrumbHome}</a>
          <span>/</span>
          <a href={href("/types", lang)} class="no-underline text-muted">{t.navTypes}</a>
          <span>/</span>
          <span class="text-ink">{t.typesGlossaryLink}</span>
        </div>
        <div class="text-[11px] font-bold uppercase tracking-[2px] text-gold">{t.glossaryEyebrow}</div>
        <h1 class="mt-3.5 font-heading text-[44px] font-medium leading-[1.14] text-ink">{t.typesGlossaryLink}</h1>
        <p class="mt-[18px] max-w-[55ch] text-[16px] leading-[1.65] text-text">
          {t.glossaryIntro}
        </p>
      </div>

      <div class="glossary-signal pointer-events-none" aria-hidden="true">
        <div class="signal-nodes">
          {
            glossaryGames.map((game) => (
              <span class="signal-node" data-game={game.id}>
                <svg viewBox={GAME_LOGOS[game.id].viewBox} fill="currentColor" stroke="none" set:html={GAME_LOGOS[game.id].svg} />
              </span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1244px] px-8 pb-20 pt-9">
    <div class="glossary-filters" role="group" aria-label={t.glossaryFilterLabel}>
      <button type="button" class="glossary-filter" data-filter="all" aria-pressed="true">{t.glossaryFilterAll}</button>
      {
        glossaryGames.map((game) => (
          <button type="button" class="glossary-filter" data-filter={game.id} aria-pressed="false" aria-label={`${game.label}（${game.title}）`}>
            {game.tag}
          </button>
        ))
      }
    </div>

    <div class="glossary-toolbar mt-6">
      <label class="glossary-search">
        <span class="sr-only">{t.glossarySearchLabel}</span>
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16.5 16.5 4 4"></path>
        </svg>
        <input id="glossary-search" type="search" placeholder={t.glossarySearchPlaceholder} autocomplete="off" />
      </label>
      <p class="glossary-count" aria-live="polite"><span
        data-glossary-count
        data-count-all={t.glossaryCountTemplate}
        data-count-filtered={t.glossaryCountFilteredTemplate}
      >{t.glossaryCountTemplate.replace("{n}", String(sorted.length))}</span></p>
    </div>

    <div class="glossary-layout mt-7">
      <div class="glossary-table" data-glossary-results>
        <div class="term-head" aria-hidden="true">
          <span>{t.glossaryColAbbr}</span>
          <span>English ／ 日本語</span>
          <span>{t.glossaryColZh}</span>
          <span></span>
          <span></span>
        </div>

        {
          groups.map((group) => (
            <section class="term-group" data-term-group id={`g-${group.anchor}`}>
              <h2 class="term-letter">{group.letter}</h2>
              <div class="term-rows">
                {group.items.map((entry) => (
                  <details
                    class="term"
                    data-term
                    data-games={entry.games.join(" ")}
                    data-search={searchIndex(entry)}
                  >
                    <summary class="term-row">
                      {/* 主鍵本身就是英文時只放英文欄，避免縮寫欄與英文欄重複同一個詞 */}
                      <span class="term-abbr">{entry.en === entry.abbr ? "" : entry.abbr}</span>
                      <span class="term-en">
                        {entry.en && <span class="term-en-main">{entry.en}</span>}
                        {entry.ja && <span class="term-ja">{entry.ja}</span>}
                      </span>
                      <span class="term-zh">{entry.zh}</span>
                      <span class="term-meta">
                        {entry.games.map((game) => <span class="term-tag">{tagOf(game)}</span>)}
                      </span>
                      <svg class="term-chevron" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <polyline points="6 9 12 15 18 9"></polyline>
                      </svg>
                    </summary>
                    <div class="term-body">
                      <p>{entry.description}</p>
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }

        <p class="glossary-empty" data-glossary-empty hidden>{t.glossaryEmpty}</p>
      </div>

      <nav class="term-rail" aria-label={t.glossaryRailLabel}>
        {groups.map((group) => <a href={`#g-${group.anchor}`} data-rail={group.anchor}>{group.letter}</a>)}
      </nav>
    </div>
  </section>

  <style>
    .glossary-hero {
      position: relative;
      isolation: isolate;
      min-height: 260px;
      overflow: hidden;
    }
    .glossary-copy {
      max-width: 720px;
    }
    .glossary-signal {
      position: absolute;
      right: clamp(20px, 6vw, 88px);
      top: 44px;
      width: min(31vw, 366px);
      aspect-ratio: 1.35;
      opacity: 0.78;
    }
    .signal-nodes {
      position: absolute;
      inset: 15% 9%;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(14px, 2.4vw, 27px) clamp(20px, 4.2vw, 50px);
      place-items: center;
    }
    .signal-node {
      display: grid;
      width: clamp(23px, 4.2vw, 42px);
      height: clamp(23px, 4.2vw, 42px);
      place-items: center;
      color: var(--muted);
      opacity: 0.28;
      transition: color 220ms ease, opacity 220ms ease, transform 220ms ease;
    }
    /* 遊戲數不是 3 的倍數時，落單在最後一列的那個放在中間欄 */
    .signal-node:last-child:nth-child(3n + 1) {
      grid-column: 2;
    }
    .signal-node svg {
      display: block;
      max-width: 100%;
      max-height: 100%;
    }
    .glossary-hero[data-active-game="all"] .signal-node {
      opacity: 0.42;
    }
    .glossary-hero[data-active-game="botw"] .signal-node,
    .glossary-hero[data-active-game="totk"] .signal-node,
    .glossary-hero[data-active-game="oot"] .signal-node,
    .glossary-hero[data-active-game="eow"] .signal-node,
    .glossary-hero[data-active-game="ssbu"] .signal-node,
    .glossary-hero[data-active-game="aoc"] .signal-node,
    .glossary-hero[data-active-game="aoi"] .signal-node {
      opacity: 0.1;
    }
    .glossary-hero[data-active-game="botw"] .signal-node[data-game="botw"],
    .glossary-hero[data-active-game="totk"] .signal-node[data-game="totk"],
    .glossary-hero[data-active-game="oot"] .signal-node[data-game="oot"],
    .glossary-hero[data-active-game="eow"] .signal-node[data-game="eow"],
    .glossary-hero[data-active-game="ssbu"] .signal-node[data-game="ssbu"],
    .glossary-hero[data-active-game="aoc"] .signal-node[data-game="aoc"],
    .glossary-hero[data-active-game="aoi"] .signal-node[data-game="aoi"] {
      color: var(--accent);
      opacity: 0.9;
      transform: translateY(-3px);
    }

    .glossary-filters {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .glossary-filter {
      min-width: 59px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: var(--surface);
      color: var(--text);
      cursor: pointer;
      padding: 8px 13px;
      font-family: var(--font-mono);
      font-size: 12px;
      transition: border-color 180ms ease, color 180ms ease, background-color 180ms ease;
    }
    .glossary-filter:hover {
      border-color: var(--brand);
    }
    .glossary-filter[aria-pressed="true"] {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--bg);
    }

    .glossary-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }
    .glossary-search {
      display: flex;
      width: min(100%, 560px);
      align-items: center;
      gap: 11px;
      border: 1px solid var(--border-strong);
      border-radius: 5px;
      background: var(--surface);
      color: var(--muted);
      padding: 0 14px;
      transition: border-color 0.2s ease;
    }
    /* 裡面那顆 input 把 outline 關掉了（見下方），焦點指示必須由外框自己畫，
       否則鍵盤使用者 Tab 到搜尋框時完全看不出焦點在哪。做法比照
       資源頁與藍圖頁的搜尋框。 */
    .glossary-search:focus-within {
      border-color: var(--accent);
    }
    .glossary-search input {
      min-width: 0;
      flex: 1;
      border: 0;
      background: transparent;
      color: var(--ink);
      outline: 0;
      padding: 13px 0;
      font-size: 15px;
    }
    .glossary-search input::placeholder {
      color: var(--muted);
    }
    .glossary-count {
      flex: none;
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 12px;
      white-space: nowrap;
    }

    /* ── 對照表：內容區＋右側字母跳轉條 ── */
    .glossary-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 24px;
      align-items: start;
    }
    .term-head {
      display: grid;
      grid-template-columns: var(--term-cols);
      gap: 18px;
      border-bottom: 1px solid var(--border-strong);
      padding: 0 14px 9px;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    /* 每一列各自是一個 grid，欄寬不可用 auto／fr 混搭決定，
       否則會依該列的標籤數量而異，列與列、列與表頭都對不齊 */
    .glossary-table {
      --term-cols: 116px minmax(0, 1fr) 190px 134px 16px;
    }
    .term-group {
      scroll-margin-top: 64px; /* 字母條跳轉時不被導覽列蓋住 */
    }
    .term-group[hidden] {
      display: none;
    }
    .term-letter {
      position: sticky;
      top: 64px; /* 站台導覽列高度，與 resources／object-map 的吸附值一致 */
      z-index: 2;
      margin: 0;
      border-bottom: 1px solid var(--border-soft);
      background: var(--bg);
      /* 沿用英文語言標記的藍色，與縮寫欄的 accent 橘色區分，
         避免字母分類標頭跟旁邊縮寫的顏色相同而難以分辨 */
      color: var(--lang-tag);
      padding: 15px 14px 7px;
      font-family: var(--font-mono);
      font-size: 12px;
      font-weight: 500;
      letter-spacing: 0.16em;
    }
    .term {
      border-bottom: 1px solid var(--border-soft);
    }
    .term[hidden] {
      display: none;
    }
    .term-row {
      display: grid;
      grid-template-columns: var(--term-cols);
      align-items: baseline;
      gap: 18px;
      cursor: pointer;
      list-style: none;
      padding: 13px 14px;
      transition: background-color 160ms ease;
    }
    .term-row::-webkit-details-marker {
      display: none;
    }
    .term-row:hover {
      background: var(--surface-2);
    }
    .term-abbr {
      color: var(--accent);
      font-family: var(--font-mono);
      font-size: 15px;
      font-weight: 500;
      overflow-wrap: anywhere;
    }
    .term-en {
      display: grid;
      gap: 3px;
      min-width: 0;
    }
    .term-en-main {
      color: var(--text);
      font-size: 14px;
      line-height: 1.45;
    }
    .term-ja {
      color: var(--lang-tag-ja);
      font-size: 12.5px;
      line-height: 1.45;
    }
    .term-zh {
      color: var(--ink);
      font-size: 15px;
      line-height: 1.45;
    }
    .term-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 6px;
    }
    .term-tag {
      border: 1px solid color-mix(in srgb, var(--accent) 46%, var(--border-strong));
      border-radius: 5px;
      color: var(--accent);
      padding: 3px 6px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .term-chevron {
      flex: none;
      color: var(--muted);
      transition: transform 180ms ease, color 180ms ease;
    }
    .term[open] .term-chevron {
      color: var(--accent);
      transform: rotate(180deg);
    }
    .term[open] .term-row {
      background: var(--surface-2);
    }
    .term-body {
      padding: 2px 14px 16px;
    }
    .term-body p {
      margin: 0;
      max-width: 72ch;
      color: var(--text);
      font-size: 14px;
      line-height: 1.7;
    }

    .term-rail {
      position: sticky;
      top: 88px;
      display: grid;
      gap: 1px;
      justify-items: center;
    }
    .term-rail a {
      display: grid;
      width: 22px;
      height: 20px;
      place-items: center;
      border-radius: 5px;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 11px;
      text-decoration: none;
      transition: color 140ms ease, background-color 140ms ease;
    }
    .term-rail a:hover {
      background: var(--surface-2);
      color: var(--accent);
    }
    .term-rail a[data-empty] {
      opacity: 0.28;
      pointer-events: none;
    }

    .glossary-empty {
      margin: 28px 0 0;
      border: 1px dashed var(--border-strong);
      border-radius: 5px;
      color: var(--muted);
      padding: 34px 20px;
      text-align: center;
    }

    /* 中寬螢幕：收掉表頭，縮寫留在左側 gutter，其餘欄位堆疊 */
    @media (max-width: 960px) {
      .glossary-table {
        --term-cols: 108px minmax(0, 1fr) 16px;
      }
      .term-head {
        display: none;
      }
      .term-row {
        align-items: start;
        gap: 3px 14px;
      }
      .term-abbr,
      .term-en,
      .term-zh,
      .term-meta {
        grid-column: 2;
      }
      .term-abbr {
        grid-column: 1;
        grid-row: 1 / -1;
      }
      .term-meta {
        justify-content: flex-start;
        margin-top: 6px;
      }
      .term-chevron {
        grid-column: 3;
        grid-row: 1 / -1;
        align-self: center;
      }
    }

    @media (max-width: 720px) {
      .glossary-hero {
        min-height: 0;
        padding-bottom: 29px;
        padding-top: 28px;
      }
      .glossary-hero h1 {
        font-size: 28px;
      }
      .glossary-copy p {
        font-size: 13px;
      }
      .glossary-signal {
        right: -24px;
        top: 72px;
        width: 190px;
        opacity: 0.35;
      }
      .glossary-copy {
        padding-right: 54px;
      }
      .glossary-filters {
        flex-wrap: nowrap;
        margin-right: -32px;
        overflow-x: auto;
        padding-right: 32px;
        scrollbar-width: none;
      }
      .glossary-filters::-webkit-scrollbar {
        display: none;
      }
      .glossary-filter {
        flex: none;
      }
      .glossary-toolbar {
        align-items: flex-start;
        flex-direction: column;
        gap: 12px;
      }
      .glossary-search {
        width: 100%;
      }
      /* 手機：多數條目沒有縮寫，留左側 gutter 會浪費近三分之一寬度，
         改成整列單欄堆疊，縮寫有才佔一行 */
      .glossary-table {
        --term-cols: minmax(0, 1fr) 16px;
      }
      .term-abbr,
      .term-en,
      .term-zh,
      .term-meta {
        grid-column: 1;
      }
      .term-abbr {
        grid-row: auto;
        font-size: 12.5px;
        letter-spacing: 0.04em;
      }
      .term-abbr:empty {
        display: none;
      }
      .term-chevron {
        grid-column: 2;
      }
      .term-zh {
        font-size: 14px;
      }
      /* 字母條改成頂部可橫向捲動的一列 */
      .glossary-layout {
        grid-template-columns: minmax(0, 1fr);
        gap: 0;
      }
      .term-rail {
        position: sticky;
        top: 97px; /* 手機版導覽列會折成兩列，比桌面高 */
        z-index: 3;
        order: -1;
        display: flex;
        margin: 0 -32px 6px;
        border-bottom: 1px solid var(--border-soft);
        background: var(--bg);
        overflow-x: auto;
        padding: 7px 32px;
        scrollbar-width: none;
      }
      .term-rail::-webkit-scrollbar {
        display: none;
      }
      .term-rail a {
        flex: none;
      }
      .term-letter {
        top: 132px; /* 導覽列 97 ＋ 字母條 35 */
      }
      .term-group {
        scroll-margin-top: 132px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .signal-node,
      .glossary-filter,
      .term-row,
      .term-chevron {
        transition: none;
      }
    }
  </style>

  <script>
    const hero = document.querySelector<HTMLElement>("[data-glossary-hero]");
    const filters = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const terms = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-term]"));
    const termGroups = Array.from(document.querySelectorAll<HTMLElement>("[data-term-group]"));
    const railLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-rail]"));
    const search = document.getElementById("glossary-search") as HTMLInputElement | null;
    const count = document.querySelector<HTMLElement>("[data-glossary-count]");
    const empty = document.querySelector<HTMLElement>("[data-glossary-empty]");

    const validGames = new Set(filters.map((filter) => filter.dataset.filter ?? "all"));
    const params = new URLSearchParams(location.search);
    let activeGame = validGames.has(params.get("game") ?? "") ? params.get("game")! : "all";

    if (search && params.get("q")) search.value = params.get("q")!;

    function syncUrl() {
      const nextParams = new URLSearchParams(location.search);
      const query = search?.value.trim() ?? "";
      if (activeGame === "all") nextParams.delete("game");
      else nextParams.set("game", activeGame);
      if (query) nextParams.set("q", query);
      else nextParams.delete("q");
      const suffix = nextParams.toString();
      history.replaceState(null, "", `${location.pathname}${suffix ? `?${suffix}` : ""}${location.hash}`);
    }

    function render() {
      const query = (search?.value ?? "").trim().toLocaleLowerCase();
      let shown = 0;

      terms.forEach((term) => {
        const inGame = activeGame === "all" || (term.dataset.games ?? "").split(" ").includes(activeGame);
        const inSearch = !query || (term.dataset.search ?? "").includes(query);
        const visible = inGame && inSearch;
        term.hidden = !visible;
        if (!visible) term.open = false;
        else shown += 1;
      });

      // 整組沒有可見條目時連字母標頭一起收掉，字母條同步變淡
      termGroups.forEach((group) => {
        const has = Array.from(group.querySelectorAll<HTMLElement>("[data-term]")).some((term) => !term.hidden);
        group.hidden = !has;
        const anchor = group.id.replace(/^g-/, "");
        const link = railLinks.find((item) => item.dataset.rail === anchor);
        if (link) {
          if (has) link.removeAttribute("data-empty");
          else link.setAttribute("data-empty", "");
        }
      });

      filters.forEach((filter) => filter.setAttribute("aria-pressed", String(filter.dataset.filter === activeGame)));
      hero?.setAttribute("data-active-game", activeGame);
      if (empty) empty.hidden = shown !== 0;
      if (count) {
        // 兩種計數格式的模板由伺服器端寫進 data 屬性（見上方 data-count-*），
        // 這段 script 沒有 define:vars，拿不到 t，只能從 DOM 取語言字串
        const tplAll = count.dataset.countAll ?? "共 {n} 條";
        const tplFiltered = count.dataset.countFiltered ?? "{shown} / {total} 條";
        count.textContent =
          shown === terms.length
            ? tplAll.replace("{n}", String(terms.length))
            : tplFiltered.replace("{shown}", String(shown)).replace("{total}", String(terms.length));
      }
      syncUrl();
    }

    filters.forEach((filter) => {
      filter.addEventListener("click", () => {
        activeGame = filter.dataset.filter ?? "all";
        render();
      });
    });

    search?.addEventListener("input", render);

    render();
  </script>
</BaseLayout>
