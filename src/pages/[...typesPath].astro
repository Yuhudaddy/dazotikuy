---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { typeGroups } from "../data/types";
import { GAME_LOGOS } from "../data/gameLogos";
import { uiStrings, type Lang } from "../data/ui-strings";

// 中文 /types、日文 /ja/types
export function getStaticPaths() {
  return [
    { params: { typesPath: "types" }, props: { lang: "zh" as Lang } },
    { params: { typesPath: "ja/types" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];
// 日文版遊戲名稱：目前只有曠野之息／王國之淚有日文簡稱（types.ts 的 group.ja），
// 其餘遊戲的日文頁沿用中文名稱，等資料層翻譯補齊後這裡不用再改。
const groupLabel = (group: (typeof typeGroups)[number]) =>
  (lang === "ja" && group.ja) || group.label;
const groupShortLabel = (group: (typeof typeGroups)[number]) =>
  (lang === "ja" && group.ja) || group.shortLabel || group.label;
---

<BaseLayout
  title={t.navTypes}
  description={t.typesDescription}
  active="types"
  lang={lang}
  altPath="/types"
>
  {/* 標題 */}
  <section class="border-b border-border-soft">
    <div class="r-types-hero mx-auto max-w-[1244px] px-8 pb-12 pt-[54px]">
      <div class="r-types-hero-content">
        <div>
          <div class="mb-[22px] flex items-center gap-2.5 text-[13px] text-muted">
            <a href={href("/home", lang)} class="no-underline text-muted">{t.breadcrumbHome}</a>
            <span>/</span>
            <span class="text-ink">{t.navTypes}</span>
          </div>
          <div class="text-[11px] font-bold uppercase tracking-[2px] text-gold">
            {t.typesEyebrow}
          </div>
          <h1 class="r-types-h1 mb-[18px] mt-3.5 font-heading text-[44px] font-medium leading-[1.14] text-ink">
            {t.navTypes}
          </h1>
          <p class="r-types-subtitle max-w-[62ch] text-[16px] leading-[1.65] text-text">
            {t.typesIntro}
          </p>
        </div>
        <a href={href("/types/glossary", lang)} class="r-terminology-link ring-hover no-underline">
          <span>{t.typesGlossaryLink}</span>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* 遊戲門扉：桌面（xl 以上）所有遊戲排成一排、不寫死個數；平板 4 欄；手機 2 欄且落單的最後一個橫跨兩欄 */}
  <div class="mx-auto max-w-[1244px] px-8 pt-10">
    <div class="r-game-tabs grid grid-cols-2 gap-3 max-sm:[&>:last-child:nth-child(odd)]:col-span-2 sm:grid-cols-4 xl:grid-flow-col xl:auto-cols-fr xl:grid-cols-none">
      {
        typeGroups.map((group) => (
          <button
            type="button"
            class="portal ring-hover relative flex cursor-pointer items-center gap-3 overflow-hidden rounded-[5px] border border-border-soft bg-surface px-4 text-left transition-colors"
            data-game={group.game}
            aria-pressed={group.game === "botw" ? "true" : "false"}
          >
            <svg
              class="portal-mark pointer-events-none flex-none"
              viewBox={GAME_LOGOS[group.game].viewBox}
              fill="currentColor"
              stroke="none"
              set:html={GAME_LOGOS[group.game].svg}
            />
            <div class="min-w-0">
              <div class="text-[10px] font-bold tracking-[1.5px] text-gold">{group.shortEn ?? group.en}</div>
              <div class="r-portal-title truncate font-heading font-medium leading-tight text-ink">
                {groupShortLabel(group)}
              </div>
            </div>
          </button>
        ))
      }
    </div>
  </div>

  {/* 各遊戲分組：一次只顯示一組 */}
  {
    typeGroups.map((group) => (
      <section
        class="lib mx-auto max-w-[1244px] px-8 pb-20 pt-[52px]"
        data-lib={group.game}
        hidden={group.game !== "botw"}
      >
        <div class="mb-[22px] flex items-end justify-between gap-5">
          <div class="flex min-w-0 items-center gap-3.5">
            <svg
              class="h-9 w-9 flex-none text-accent"
              viewBox={GAME_LOGOS[group.game].viewBox}
              fill="currentColor"
              stroke="none"
              set:html={GAME_LOGOS[group.game].svg}
            />
            <div class="min-w-0">
              <div class="text-[11px] font-bold uppercase tracking-[2px] text-gold">
                {group.en}
              </div>
              <h2 class="r-type-group-title mt-1 truncate font-heading text-[28px] font-medium text-ink">
                {groupLabel(group)}
              </h2>
            </div>
          </div>
          <a
            href={href(`/videos?game=${group.game}`, lang)}
            class="whitespace-nowrap text-sm text-accent no-underline"
          >
            {t.typesAllVideos}
          </a>
        </div>

        {group.items.filter((item) => !item.hideFromGrid).length > 0 ? (
          <div class="r-type-grid grid grid-cols-[repeat(auto-fill,minmax(248px,1fr))] gap-x-10 gap-y-2">
            {/* 內容連結不包框也不畫底線，靠留白分隔；滑鼠移入才由左至右拉出漸層線。
                外框留給控制項（上方遊戲切換） */}
            {group.items.filter((item) => !item.hideFromGrid).map((item) => (
              <a
                href={href(`/types/${group.game}-${item.no}`, lang)}
                class="type-link group flex min-w-0 flex-col pb-3 pt-2.5 no-underline"
              >
                <div class="flex min-w-0 items-baseline gap-2">
                  <span class="flex-none font-mono text-[13px] text-accent">{item.no}</span>
                  <span class="truncate font-heading text-[18px] font-medium text-ink">
                    {lang === "ja" ? item.shortJa ?? item.ja ?? item.shortZh ?? item.zh : item.shortZh ?? item.zh}
                  </span>
                </div>
                <div class="truncate text-[12px] text-muted">{item.shortEn ?? item.en}</div>
              </a>
            ))}
          </div>
        ) : (
          <div class="flex flex-col items-center gap-3 rounded-[5px] border border-dashed border-border-soft py-20 text-center">
            <svg
              class="h-14 w-14 text-muted opacity-40"
              viewBox={GAME_LOGOS[group.game].viewBox}
              fill="currentColor"
              stroke="none"
              set:html={GAME_LOGOS[group.game].svg}
            />
            <p class="font-heading text-xl font-medium text-ink">{t.typesEmptyTitle}</p>
            <p class="text-sm text-muted">
              {t.typesEmptyHintTemplate.replace("{game}", groupShortLabel(group))}
            </p>
          </div>
        )}
      </section>
    ))
  }

<style>
  /* ── 文件頁籤：xl 以上一排、其餘 4 欄、手機 2 欄（沿用資料網站的樣式） ── */
  .portal {
    height: clamp(52px, 9vw, 64px);
  }

  .r-types-hero-content {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
  }
  /* 主題連結：平時只有文字，滑鼠移入時底線由左至右展開，
     展開後漸層持續向左流動，形成脈衝感。
     四段色由淺到深，深色主題整組往亮處移，否則最深的一段會沉進背景。 */
  .type-link {
    position: relative;
    --u1: #9cc4f5;
    --u2: #5fa3ec;
    --u3: #1668c0;
    --u4: #0f4a8f;
  }

  :global([data-theme="dark"]) .type-link {
    --u1: #bff3f9;
    --u2: #5fd7e4;
    --u3: #03c1d5;
    --u4: #0891a1;
  }

  .type-link::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    border-radius: 1px;
    /* 頭尾同色，位移一圈之後才接得上，不會出現斷點 */
    background: linear-gradient(
      90deg,
      var(--u1) 0%,
      var(--u2) 25%,
      var(--u3) 50%,
      var(--u4) 75%,
      var(--u1) 100%
    );
    background-size: 200% 100%;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 320ms cubic-bezier(0.22, 0.8, 0.36, 1);
  }

  .type-link:hover::after,
  .type-link:focus-visible::after {
    transform: scaleX(1);
    animation: type-link-flow 1.8s linear infinite;
  }

  @keyframes type-link-flow {
    to {
      background-position: -200% 0;
    }
  }

  /* 減少動態時保留底線本身，只拿掉展開與流動 */
  @media (prefers-reduced-motion: reduce) {
    .type-link::after {
      transform: scaleX(1);
      opacity: 0;
      transition: opacity 200ms ease;
    }
    .type-link:hover::after,
    .type-link:focus-visible::after {
      opacity: 1;
      animation: none;
    }
  }

  .r-terminology-link {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 9px;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--surface);
    color: var(--accent);
    padding: 9px 14px;
    font-size: 14px;
    transition: border-color 180ms ease, background-color 180ms ease;
  }
  .r-terminology-link:hover,
  .r-terminology-link:focus-visible {
    border-color: var(--brand);
  }
  .portal-mark {
    width: clamp(24px, 6vw, 32px);
    height: clamp(24px, 6vw, 32px);
    color: var(--muted);
    opacity: 0.55;
    transition: opacity 0.25s ease, color 0.25s ease;
  }
  .r-portal-title {
    font-size: clamp(14px, 3.4vw, 16px);
  }
  .portal:hover .portal-mark {
    opacity: 0.8;
  }
  .portal[aria-pressed="true"] {
    border-color: var(--ink-warm);
    background: color-mix(in srgb, var(--ink-warm) 5%, var(--surface));
  }
  .portal[aria-pressed="true"] .portal-mark {
    color: var(--ink-warm);
    opacity: 0.9;
  }
  .portal[aria-pressed="false"] {
    opacity: 0.75;
  }
  .portal[aria-pressed="false"]:hover {
    opacity: 1;
  }

  /* ── 切換遊戲時的浮現動畫 ── */
  @keyframes types-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .lib.entering {
    animation: types-rise 0.45s cubic-bezier(0.22, 0.8, 0.36, 1) both;
  }

  @media (prefers-reduced-motion: reduce) {
    .lib.entering {
      animation: none;
    }
    .portal-mark {
      transition: none;
    }
  }

  @media (max-width: 600px) {
    .r-types-hero {
      padding-top: 28px;
      padding-bottom: 24px;
    }
    .r-types-h1 {
      font-size: 26px;
    }
    .r-types-subtitle {
      font-size: 12px;
    }
    .r-types-hero-content {
      align-items: flex-start;
      flex-direction: column;
      gap: 17px;
    }
    .r-terminology-link {
      font-size: 13px;
    }
    .r-type-group-title {
      font-size: 24px;
    }
    .r-type-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }
</style>

  <script>
    const portals = Array.from(document.querySelectorAll<HTMLButtonElement>(".portal"));
    const libs = Array.from(document.querySelectorAll<HTMLElement>(".lib"));
    const gameOrder = portals.map((p) => p.dataset.game ?? "");

    function setGame(game: string, animate = true) {
      if (!libs.some((l) => l.dataset.lib === game)) return;
      portals.forEach((p) => p.setAttribute("aria-pressed", String(p.dataset.game === game)));
      libs.forEach((l) => {
        const on = l.dataset.lib === game;
        l.hidden = !on;
        l.classList.remove("entering");
        if (on && animate) {
          void l.offsetWidth;
          l.classList.add("entering");
        }
      });
      history.replaceState(null, "", `#${game}`);
    }

    portals.forEach((p) =>
      p.addEventListener("click", () => {
        if (p.getAttribute("aria-pressed") !== "true") setGame(p.dataset.game ?? "botw");
      })
    );

    const initial = location.hash.replace("#", "");
    if (gameOrder.includes(initial)) setGame(initial, false);
  </script>
</BaseLayout>
