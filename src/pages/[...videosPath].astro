---
import BaseLayout from "../layouts/BaseLayout.astro";
import { allVideos } from "../data/youtube";
import { gameList, gameListFor } from "../data/types";
import { uiStrings, type Lang } from "../data/ui-strings";

// 中文 /videos、日文 /ja/videos。檔名用 rest 參數才有辦法讓同一份模板
// 產出兩種完整路徑（詳見 [...typePath].astro 開頭的說明）。
export function getStaticPaths() {
  return [
    { params: { videosPath: "videos" }, props: { lang: "zh" as Lang } },
    { params: { videosPath: "ja/videos" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];

const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

// 兩種資料形狀（建置時抓過 vs 只有種子）的處理集中在 src/data/youtube.ts，
// 這裡拿到的已經是統一過、有型別的陣列。
const rawAll = allVideos(gameList.map(({ id }) => id));
// 日文頁只有曠野之息／王國之淚有翻譯，其餘遊戲名稱沿用中文（見 types.ts 的 gameLabelFor）
const gameLabelMap = Object.fromEntries(gameListFor(lang).map(({ id, label }) => [id, label]));
const videos = rawAll.map((v) => ({
  ytId: v.id,
  title: v.title,
  game: v.game ?? "",
  gameLabel: gameLabelMap[v.game as keyof typeof gameLabelMap] ?? "",
  search: [v.title, v.meta ?? "", gameLabelMap[v.game as keyof typeof gameLabelMap] ?? "", v.game ?? ""]
    .join(" ")
    .toLowerCase(),
}));

// 篩選鈕：列出所有遊戲，包含還沒有影片的新分類（例如時之笛）。
// 以前只列有影片的遊戲，結果新遊戲在第一支影片上傳前沒有按鈕，
// 連 /videos?game=oot 這種來自主題頁「全部影片」的連結也會被當成無效而忽略。
// 點到沒有影片的遊戲會顯示空狀態，並可由篩選提示列清除。
const facets = gameListFor(lang).map(({ id, label }) => ({ key: id, label }));
---

<BaseLayout title={t.navVideos} active="videos" lang={lang} altPath="/videos">
  <section class="mx-auto max-w-[1244px] px-8 pb-[84px] pt-12">
    <div class="text-[11px] font-bold uppercase tracking-[2px] text-gold">{t.videosEyebrow}</div>
    <h1 class="mb-2.5 mt-3.5 font-heading text-[26px] sm:text-[34px] font-medium text-ink">{t.videosHeading}</h1>
    <p class="mb-7 max-w-[60ch] text-[12px] sm:text-base leading-[1.6] text-text">
      {t.videosIntro}
    </p>

    {/* 搜尋框 */}
    <div class="relative mb-[18px] max-w-[560px]">
      <span class="pointer-events-none absolute left-[15px] top-1/2 -translate-y-1/2 text-muted">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
      </span>
      {/* placeholder 不算可及名稱：一旦使用者開始打字它就消失，讀屏也不保證會唸。
          搜尋框需要一個穩定的名稱，這裡用既有的 searchLabel。 */}
      <input
        id="idx-search"
        type="search"
        aria-label={t.searchLabel}
        placeholder={t.videosSearchPlaceholder}
        class="w-full rounded-[5px] border border-border-strong bg-surface py-[13px] pl-11 pr-4 text-[15px] text-ink outline-none focus:border-brand"
      />
    </div>

    {/* 遊戲篩選 */}
    <div id="idx-facets" class="mb-9 flex flex-wrap gap-2.5">
      <button type="button" data-game="" aria-pressed="false" class="chip rounded-[5px] border border-border-strong px-[15px] py-[7px] text-sm">
        {t.videosFilterAll}
      </button>
      {
        facets.map((f) => (
          <button type="button" data-game={f.key} aria-pressed="false" class="chip rounded-[5px] border border-border-strong px-[15px] py-[7px] text-sm">
            {f.label}
          </button>
        ))
      }
    </div>

    {/* 結果區（由 JS 渲染） */}
    <div id="idx-results"></div>

    {/* 空狀態 */}
    <div id="idx-empty" class="hidden py-[60px] text-center text-muted">
      <p class="mb-2 font-heading text-[22px] text-ink">{t.videosEmptyTitle}</p>
      <p class="text-[15px]">{t.videosEmptyHint}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .chip {
    cursor: pointer;
    background: var(--surface);
    color: var(--text);
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .chip[data-active="true"] {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }

  /* ── 以下為動態注入 HTML 的樣式，須用 :global() 繞過 Astro scoping ── */
  :global(.idx-bucket-title) {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 500;
    margin: 8px 0 4px;
  }
  :global(.idx-row) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 11px 6px;
    border-bottom: 1px solid var(--border-soft);
    text-decoration: none;
    transition: background-color 0.12s;
    min-height: 44px;
  }
  :global(.idx-row:hover) {
    background: var(--surface);
    border-radius: 5px;
  }
  :global(.idx-tag) {
    font-size: 12px;
    padding: 3px 10px;
    border-radius: 5px;
    background: var(--surface);
    color: var(--muted);
    white-space: nowrap;
    box-shadow: 0 0 0 1px var(--border-strong);
    flex: none;
  }
  :global(.idx-hl) {
    color: var(--accent);
    font-weight: 500;
  }
  :global(.idx-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    padding: 4px 0;
  }
  :global(.idx-grid-card) {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    background: var(--surface);
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  :global(.idx-grid-card:hover) {
    border-color: var(--brand);
    box-shadow: 0 2px 12px var(--shadow);
  }
  :global(.idx-grid-card img) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--sand);
    display: block;
  }
  :global(.idx-grid-card-body) {
    padding: 10px 12px 12px;
    flex: 1;
  }
  :global(.view-btn) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 5px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--muted);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  :global(.view-btn[data-active="true"]) {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  :global(.view-btn:hover:not([data-active="true"])) {
    background: var(--surface-2);
    color: var(--ink);
  }
  :global(.page-btn) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    padding: 0 6px;
    border-radius: 5px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
    transition: background-color 0.12s, color 0.12s, border-color 0.12s;
  }
  :global(.page-btn[data-active="true"]) {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  :global(.page-btn:hover:not([data-active="true"]):not(:disabled)) {
    background: var(--surface-2);
    color: var(--ink);
  }
  :global(.page-btn:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  /* 分頁列外層：避免頁碼過多時撐破版面，改為可橫向捲動 */
  :global(.page-scroll) {
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  :global(.page-scroll::-webkit-scrollbar) {
    display: none;
  }
  :global(.page-btn) {
    flex-shrink: 0;
  }
  :global(.filter-pill) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s;
  }
  :global(.filter-pill:hover) {
    border-color: var(--brand);
    color: var(--brand);
  }
  :global(.filter-pill-x) {
    flex-shrink: 0;
  }
  @media (max-width: 768px) {
    :global(.idx-grid) {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    :global(.idx-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>

<script define:vars={{ videos, facets, BASE, i18n: {
  filterLabel: t.videosFilterLabel,
  totalHint: t.videosTotalHintTemplate,
  resultCount: t.videosResultCountTemplate,
  viewList: t.videosViewList,
  viewGrid: t.videosViewGrid,
  prevPage: t.videoPrevPageLabel,
  nextPage: t.videoNextPageLabel,
  pageLabel: t.videoPageLabel,
} }}>
  (function () {
    var search = document.getElementById("idx-search");
    var facetBox = document.getElementById("idx-facets");
    var results = document.getElementById("idx-results");
    var empty = document.getElementById("idx-empty");
    var chips = Array.prototype.slice.call(document.querySelectorAll(".chip"));

    var game = "";
    var terms = [];
    var viewMode = "list"; // "list" | "grid"
    var videoPage = 0;
    var VIDEOS_PER_LIST = 10;
    var VIDEOS_PER_GRID = 40;

    /* ── 工具函式 ── */
    function esc(s) {
      return String(s).replace(/[&<>]/g, function (c) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c];
      });
    }
    function escRe(s) {
      return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    }
    function hl(text) {
      var out = esc(text);
      for (var i = 0; i < terms.length; i++) {
        if (!terms[i]) continue;
        out = out.replace(new RegExp(escRe(terms[i]), "gi"), function (m) {
          return '<span class="idx-hl">' + m + "</span>";
        });
      }
      return out;
    }
    function matchAll(hay) {
      for (var i = 0; i < terms.length; i++) {
        if (terms[i] && hay.indexOf(terms[i]) < 0) return false;
      }
      return true;
    }
    function inGame(g) {
      return !game || g === game;
    }
    // 這支 script 是 is:inline 的純 JS，沒辦法 import src/lib/url.ts，只能複寫一份。
    // 政策要跟 VideoCard 一致：maxresdefault 畫質好但只有 720p 以上的影片才有，
    // 載不到就退回每支都有的 hqdefault（hqdefault 是 4:3 含黑邊，靠卡片的
    // object-fit: cover 裁掉）。
    function ytThumb(id) {
      return "https://img.youtube.com/vi/" + id + "/maxresdefault.jpg";
    }
    function ytThumbFallback(id) {
      return "https://img.youtube.com/vi/" + id + "/hqdefault.jpg";
    }

    /* ── 影片列（純文字，無縮圖） ── */
    function videoListRow(v) {
      return (
        '<a class="idx-row" href="https://youtu.be/' + v.ytId + '" target="_blank" rel="noopener">' +
        '<svg style="flex:none;color:var(--accent);" viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>' +
        '<div style="flex:1; min-width:0;">' +
        '<div style="font-size:14px; line-height:1.4; color:var(--ink);" class="font-heading">' + hl(v.title) + "</div>" +
        (v.gameLabel ? '<div style="font-size:12px; color:var(--muted); margin-top:2px;">' + esc(v.gameLabel) + "</div>" : "") +
        "</div>" +
        "</a>"
      );
    }

    /* ── 影片格狀卡 ── */
    function videoGridCard(v) {
      return (
        '<a class="idx-grid-card" href="https://youtu.be/' + v.ytId + '" target="_blank" rel="noopener">' +
        '<img loading="lazy" alt="" src="' + ytThumb(v.ytId) +
          '" onerror="this.onerror=null;this.src=\'' + ytThumbFallback(v.ytId) + '\'" />' +
        '<div class="idx-grid-card-body">' +
        '<div style="font-size:13px; line-height:1.4; color:var(--ink); display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;" class="font-heading">' + hl(v.title) + "</div>" +
        (v.gameLabel ? '<div style="font-size:11px; color:var(--muted); margin-top:5px;">' + esc(v.gameLabel) + "</div>" : "") +
        "</div>" +
        "</a>"
      );
    }

    /* ── 分頁列 ── */
    function paginationHTML(current, total) {
      // 包在 <nav> 裡並給它「第 n 頁，共 m 頁」的標籤，讀屏才知道這一區是分頁
      // 以及目前在哪一頁；翻頁鈕只有箭頭符號，可及名稱必須另外用 aria-label 補。
      var navLabel = esc(i18n.pageLabel.replace("{page}", current + 1).replace("{total}", total));
      var html = '<nav class="page-scroll" aria-label="' + navLabel + '" style="overflow-x:auto;margin-top:22px;padding-bottom:4px;">' +
        '<div style="display:flex;align-items:center;justify-content:center;gap:5px;width:max-content;margin:0 auto;">';

      // 上一頁
      html += '<button class="page-btn" aria-label="' + esc(i18n.prevPage) + '" data-page="' + (current - 1) + '"' + (current === 0 ? " disabled" : "") + ">←</button>";

      // 頁碼（桌面最多顯示 7 個，手機縮減為 5 個，超出用 …）
      var maxVisible = window.innerWidth < 480 ? 5 : 7;
      var half = Math.floor((maxVisible - 1) / 2);
      var start = Math.max(0, current - half);
      var end = Math.min(total - 1, start + maxVisible - 1);
      if (end - start < maxVisible - 1) start = Math.max(0, end - (maxVisible - 1));

      if (start > 0) {
        html += '<button class="page-btn" data-page="0">1</button>';
        if (start > 1) html += '<span style="color:var(--muted);font-size:13px;padding:0 2px;">…</span>';
      }
      for (var i = start; i <= end; i++) {
        var isCurrent = i === current;
        html += '<button class="page-btn" data-page="' + i + '" data-active="' + (isCurrent ? "true" : "false") + '"' +
          (isCurrent ? ' aria-current="page"' : "") + ">" + (i + 1) + "</button>";
      }
      if (end < total - 1) {
        if (end < total - 2) html += '<span style="color:var(--muted);font-size:13px;padding:0 2px;">…</span>';
        html += '<button class="page-btn" data-page="' + (total - 1) + '">' + total + "</button>";
      }

      // 下一頁
      html += '<button class="page-btn" aria-label="' + esc(i18n.nextPage) + '" data-page="' + (current + 1) + '"' + (current === total - 1 ? " disabled" : "") + ">→</button>";
      html += "</div></nav>";
      return html;
    }

    /* ── 篩選提示列（顯示目前套用的遊戲標籤／關鍵字，各自可個別清除） ── */
    function filterBarHTML() {
      var pills = "";
      if (game) {
        var gLabel = "";
        for (var i = 0; i < facets.length; i++) {
          if (facets[i].key === game) { gLabel = facets[i].label; break; }
        }
        pills +=
          '<button type="button" class="filter-pill" data-clear="game">' + esc(gLabel || game) +
          '<svg class="filter-pill-x" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
          "</button>";
      }
      if (terms.length > 0) {
        pills +=
          '<button type="button" class="filter-pill" data-clear="search">「' + esc(terms.join(" ")) + '」' +
          '<svg class="filter-pill-x" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
          "</button>";
      }
      if (!pills) return "";
      return (
        '<div style="display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:14px;">' +
        '<span style="font-size:12px;color:var(--muted);">' + i18n.filterLabel + '</span>' +
        pills +
        "</div>"
      );
    }

    /* ── 切換按鈕 HTML ── */
    function viewToggleHTML() {
      return (
        '<div style="display:flex;gap:5px;">' +
        '<button class="view-btn" data-view="list" data-active="' + (viewMode === "list" ? "true" : "false") + '" aria-pressed="' + (viewMode === "list" ? "true" : "false") + '" aria-label="' + esc(i18n.viewList) + '" title="' + esc(i18n.viewList) + '">' +
        '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>' +
        "</button>" +
        '<button class="view-btn" data-view="grid" data-active="' + (viewMode === "grid" ? "true" : "false") + '" aria-pressed="' + (viewMode === "grid" ? "true" : "false") + '" aria-label="' + esc(i18n.viewGrid) + '" title="' + esc(i18n.viewGrid) + '">' +
        '<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect></svg>' +
        "</button>" +
        "</div>"
      );
    }

    /* ── 主要渲染 ── */
    function render() {
      var hasSearch = terms.length > 0;
      var hasFilter = hasSearch || !!game;
      var html = "";

      var totalVideos = videos.filter(function (v) { return inGame(v.game); }).length;
      var mv = hasFilter
        ? videos.filter(function (v) { return inGame(v.game) && matchAll(v.search); })
        : [];

      /* 篩選提示列 */
      if (hasFilter) html += filterBarHTML();

      /* 預設狀態：僅顯示統計提示 */
      if (!hasFilter) {
        html += '<div style="font-size:13px;color:var(--muted);margin-bottom:10px;">' + i18n.totalHint.replace('{n}', totalVideos) + '</div>';
      }

      /* 搜尋結果：影片 */
      if (hasFilter && mv.length > 0) {
        var perPage = viewMode === "list" ? VIDEOS_PER_LIST : VIDEOS_PER_GRID;
        var totalPages = Math.ceil(mv.length / perPage);
        if (videoPage >= totalPages) videoPage = 0;
        var pageVideos = mv.slice(videoPage * perPage, (videoPage + 1) * perPage);

        /* 標題列 + 切換按鈕 */
        html += '<div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">';
        html +=
          '<div class="idx-bucket-title" style="margin:0;color:var(--muted);">' +
          '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><polygon points="6 4 20 12 6 20 6 4"></polygon></svg>' +
          i18n.resultCount.replace('{n}', mv.length) + "</div>";
        html += viewToggleHTML();
        html += "</div>";

        if (viewMode === "list") {
          for (var j = 0; j < pageVideos.length; j++) html += videoListRow(pageVideos[j]);
        } else {
          html += '<div class="idx-grid">';
          for (var k = 0; k < pageVideos.length; k++) html += videoGridCard(pageVideos[k]);
          html += "</div>";
        }

        if (totalPages > 1) html += paginationHTML(videoPage, totalPages);
      }

      results.innerHTML = html;

      /* 分頁列：讓目前頁碼自動捲動到可視範圍內（手機版可橫向捲動） */
      var activePageBtn = results.querySelector('.page-btn[data-active="true"]');
      if (activePageBtn) activePageBtn.scrollIntoView({ block: "nearest", inline: "center" });

      /* 動態按鈕事件 */
      results.querySelectorAll(".view-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          viewMode = this.getAttribute("data-view");
          videoPage = 0;
          render();
        });
      });
      results.querySelectorAll(".page-btn").forEach(function (btn) {
        btn.addEventListener("click", function () {
          if (this.disabled) return;
          videoPage = parseInt(this.getAttribute("data-page"), 10);
          render();
          results.scrollIntoView({ behavior: "smooth", block: "nearest" });
        });
      });
      results.querySelectorAll(".filter-pill").forEach(function (btn) {
        btn.addEventListener("click", function () {
          var clear = this.getAttribute("data-clear");
          if (clear === "game") {
            game = "";
            setActiveChip();
          } else if (clear === "search") {
            terms = [];
            if (search) search.value = "";
          }
          videoPage = 0;
          render();
        });
      });

      /* 空狀態：有篩選但無結果 */
      var showEmpty = hasFilter && mv.length === 0;
      if (empty) empty.classList.toggle("hidden", !showEmpty);
    }

    /* ── Chip active 狀態 ── */
    function setActiveChip() {
      chips.forEach(function (c) {
        // data-active 只驅動樣式，讀屏看不到；aria-pressed 才是「這顆是不是按下
        // 狀態」的無障礙表達，全站其他篩選列（術語表、資源頁）都是這樣做。
        var on = c.getAttribute("data-game") === game;
        c.setAttribute("data-active", on ? "true" : "false");
        c.setAttribute("aria-pressed", on ? "true" : "false");
      });
    }
    function setTerms(str) {
      terms = (str || "").toLowerCase().split(/\s+/).filter(Boolean);
      videoPage = 0;
    }

    /* ── 初始化：讀 URL ?search= / ?tag= / ?game= ── */
    try {
      var params = new URLSearchParams(window.location.search);
      var q = params.get("search") || params.get("tag") || "";
      var g = params.get("game") || "";
      if (g && facets.some(function (f) { return f.key === g; })) game = g;
      if (q) {
        setTerms(q);
        if (search) search.value = q;
      }
    } catch (e) {}

    setActiveChip();
    render();

    if (search) {
      search.addEventListener("input", function (e) {
        setTerms((e.target.value || "").trim());
        render();
      });
    }
    if (facetBox) {
      facetBox.addEventListener("click", function (e) {
        var btn = e.target.closest(".chip");
        if (!btn) return;
        game = btn.getAttribute("data-game") || "";
        videoPage = 0;
        setActiveChip();
        render();
      });
    }
  })();
</script>
