---
import BaseLayout from "../layouts/BaseLayout.astro";
import { href } from "../lib/url";
import { resourceGames, RESOURCES_CREDIT, type ResourceKind } from "../data/resources";
import { GAME_LOGOS } from "../data/gameLogos";
import { uiStrings, type Lang } from "../data/ui-strings";

// 中文 /resources、日文 /ja/resources
export function getStaticPaths() {
  return [
    { params: { resourcesPath: "resources" }, props: { lang: "zh" as Lang } },
    { params: { resourcesPath: "ja/resources" }, props: { lang: "ja" as Lang } },
  ];
}

const { lang } = Astro.props;
const t = uiStrings[lang];
// 日文版遊戲名稱：目前只有曠野之息／王國之淚有日文簡稱（resources.ts 的 g.ja），
// 其餘遊戲的日文頁沿用中文名稱，等資料層翻譯補齊後這裡不用再改。
const groupShortLabel = (g: (typeof resourceGames)[number]) =>
  (lang === "ja" && g.ja) || g.shortLabel || g.label;

// 各類型圖示（stroke 線稿，吃 currentColor）
const KIND_ICONS: Record<ResourceKind, string> = {
  blueprint:
    '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h2v2h-2zM18 14h2v4h-2zM14 18h4v2h-4z"/>',
  sheet:
    '<rect x="3" y="4" width="18" height="16" rx="2"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="9" y1="10" x2="9" y2="20"/><line x1="15" y1="10" x2="15" y2="20"/>',
  doc: '<path d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><path d="M14 2v6h6"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="14" y2="17"/>',
  slides:
    '<rect x="3" y="4" width="18" height="12" rx="2"/><line x1="12" y1="16" x2="12" y2="20"/><line x1="8" y1="20" x2="16" y2="20"/><line x1="7" y1="8" x2="13" y2="8"/><line x1="7" y1="12" x2="17" y2="12"/>',
  map: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><line x1="9" y1="4" x2="9" y2="18"/><line x1="15" y1="6" x2="15" y2="20"/>',
  forum:
    '<path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7A8.4 8.4 0 1 1 21 11.5z"/>',
  video:
    '<rect x="2" y="5" width="20" height="14" rx="3"/><polygon points="10,9.3 15,12 10,14.7" fill="currentColor" stroke="none"/>',
  tool: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>',
  site: '<circle cx="12" cy="12" r="9"/><line x1="3" y1="12" x2="21" y2="12"/><path d="M12 3a13.5 13.5 0 0 1 0 18 13.5 13.5 0 0 1 0-18z"/>',
};

// 星星篩選圖示：站長本人推薦且常用
const STAR_ICON =
  '<polygon points="12 2 14.9 8.6 22 9.3 16.8 13.9 18.2 21 12 17.3 5.8 21 7.2 13.9 2 9.3 9.1 8.6"/>';

// 連結來源的顯示名稱
function sourceLabel(url: string): string {
  try {
    const u = new URL(url);
    const h = u.hostname.replace(/^www\./, "");
    if (h === "docs.google.com") {
      if (u.pathname.startsWith("/spreadsheets")) return "Google Sheets";
      if (u.pathname.startsWith("/document")) return "Google Docs";
      if (u.pathname.startsWith("/presentation")) return "Google Slides";
    }
    if (h === "google.com" && u.pathname.startsWith("/maps")) return "Google Maps";
    const MAP: Record<string, string> = {
      "forum.gamer.com.tw": "巴哈姆特",
      "reddit.com": "Reddit",
      "youtube.com": "YouTube",
      "gamertw.com": "GamerTW",
      "ign.com": "IGN",
      "zeldadungeon.net": "Zelda Dungeon",
      "gamefaqs.gamespot.com": "GameFAQs",
      "mapgenie.io": "Map Genie",
      "zeldamaps.com": "Zelda Maps",
      "polygon.com": "Polygon",
      "gamewith.jp": "GameWith",
      "gamewith.net": "GameWith",
      "haozzone.notion.site": "Notion",
      "gist.github.com": "GitHub Gist",
      "gosunoob.com": "GosuNoob",
      "totkcookbook.com": "TotK Cookbook",
      "zelda.recipes": "Zelda Recipes",
      "zonai-fusion.link": "Zonai Fusion",
      "symbol.codes": "Hsin-Po",
    };
    if (MAP[h]) return MAP[h];
    if (h.endsWith(".zeldamods.org") || h === "zeldamods.org") return "ZeldaMods";
    return h;
  } catch {
    return "";
  }
}
---

<BaseLayout
  title={t.navResources}
  description={t.resourcesDescription}
  active="resources"
  lang={lang}
  altPath="/resources"
>
  {/* 標題 */}
  <section class="border-b border-border-soft">
    <div class="r-res-hero mx-auto max-w-[1244px] px-8 pb-12 pt-[54px]">
      <div class="mb-[22px] flex items-center gap-2.5 text-[13px] text-muted">
        <a href={href("/home", lang)} class="no-underline text-muted">{t.breadcrumbHome}</a>
        <span>/</span>
        <span class="text-ink">{t.navResources}</span>
      </div>
      <div class="text-[11px] font-bold uppercase tracking-[2px] text-gold">
        {t.resourcesEyebrow}
      </div>
      <h1 class="r-res-h1 mb-[18px] mt-3.5 font-heading text-[44px] font-medium leading-[1.14] text-ink">
        {t.navResources}
      </h1>
      <p class="r-res-subtitle max-w-[62ch] text-[16px] leading-[1.65] text-text">
        {t.resourcesIntro}
      </p>
    </div>
  </section>

  {/* 遊戲分頁：文件頁籤樣式，桌面（xl 以上）所有遊戲排成一排、不寫死個數；平板 4 欄；手機 2 欄且落單的最後一個橫跨兩欄 */}
  <div class="mx-auto max-w-[1244px] px-8 pt-10">
    <div class="r-game-tabs grid grid-cols-2 gap-3 max-sm:[&>:last-child:nth-child(odd)]:col-span-2 sm:grid-cols-4 xl:grid-flow-col xl:auto-cols-fr xl:grid-cols-none">
      {
        resourceGames.map((g) => (
          <button
            type="button"
            class="portal ring-hover relative flex cursor-pointer items-center gap-3 overflow-hidden rounded-[5px] border border-border-soft bg-surface px-4 text-left transition-colors"
            data-game={g.game}
            aria-pressed={g.game === "botw" ? "true" : "false"}
          >
            <svg
              class="portal-mark pointer-events-none flex-none"
              viewBox={GAME_LOGOS[g.game].viewBox}
              fill="currentColor"
              stroke="none"
              set:html={GAME_LOGOS[g.game].svg}
            />
            <div class="min-w-0">
              <div class="truncate text-[10px] font-bold tracking-[1.5px] text-gold">{g.shortEn ?? g.en}</div>
              <div class="r-portal-title truncate font-heading font-medium leading-tight text-ink">
                {groupShortLabel(g)}
              </div>
            </div>
          </button>
        ))
      }
    </div>
  </div>

  {/* 搜尋 + 分類圖示列 */}
  <div class="r-res-toolbar border-b border-border-soft bg-bg">
    <div class="mx-auto flex max-w-[1244px] flex-col gap-3 px-8 py-3.5 sm:flex-row sm:items-center">
      <div
        class="flex flex-1 items-center rounded-[5px] border border-border-strong bg-surface transition-colors focus-within:border-brand md:flex-none md:w-[260px]"
      >
        <svg
          class="ml-3 flex-none text-muted"
          viewBox="0 0 24 24"
          width="14"
          height="14"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          id="res-search"
          type="text"
          placeholder={t.resourcesSearchPlaceholder}
          autocomplete="off"
          class="w-full bg-transparent py-2 pl-2.5 pr-3 text-sm text-ink outline-none placeholder:text-muted"
        />
      </div>
      <div id="res-count" class="font-mono text-[12px] text-muted" data-count-tpl={t.resourcesCountTemplate}></div>
      <div class="ml-auto flex items-center gap-1.5">
        <button
          type="button"
          aria-pressed="false"
          aria-label={t.resourcesKindRecommended}
          title={t.resourcesKindRecommended}
          class="res-filter flex h-9 w-9 items-center justify-center rounded-[5px] border border-border-soft bg-surface text-muted transition-all hover:border-brand hover:text-accent"
          data-kind="star"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={STAR_ICON}
          />
        </button>
        <button
          type="button"
          aria-pressed="false"
          aria-label={t.resourcesKindMap}
          title={t.resourcesKindMap}
          class="res-filter flex h-9 w-9 items-center justify-center rounded-[5px] border border-border-soft bg-surface text-muted transition-all hover:border-brand hover:text-accent"
          data-kind="map"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={KIND_ICONS.map}
          />
        </button>
        <button
          type="button"
          aria-pressed="false"
          aria-label={t.resourcesKindData}
          title={t.resourcesKindData}
          class="res-filter flex h-9 w-9 items-center justify-center rounded-[5px] border border-border-soft bg-surface text-muted transition-all hover:border-brand hover:text-accent"
          data-kind="sheet"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={KIND_ICONS.sheet}
          />
        </button>
        <button
          type="button"
          aria-pressed="false"
          aria-label={t.resourcesKindDoc}
          title={t.resourcesKindDoc}
          class="res-filter flex h-9 w-9 items-center justify-center rounded-[5px] border border-border-soft bg-surface text-muted transition-all hover:border-brand hover:text-accent"
          data-kind="doc"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={KIND_ICONS.doc}
          />
        </button>
        <button
          type="button"
          aria-pressed="false"
          aria-label={t.resourcesKindSite}
          title={t.resourcesKindSite}
          class="res-filter flex h-9 w-9 items-center justify-center rounded-[5px] border border-border-soft bg-surface text-muted transition-all hover:border-brand hover:text-accent"
          data-kind="site"
        >
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={KIND_ICONS.site}
          />
        </button>
      </div>
    </div>
  </div>

  {/* 資源清單 */}
  {
    resourceGames.map((g) => (
      <div
        class="lib mx-auto max-w-[1244px] px-8 pb-20"
        data-lib={g.game}
        hidden={g.game !== "botw"}
      >
        {g.categories.length === 0 && (
          <div class="flex flex-col items-center gap-3 py-24 text-center">
            <svg
              class="h-14 w-14 text-muted opacity-40"
              viewBox={GAME_LOGOS[g.game].viewBox}
              fill="currentColor"
              stroke="none"
              set:html={GAME_LOGOS[g.game].svg}
            />
            <p class="font-heading text-xl font-medium text-ink">{t.resourcesEmptyTitle}</p>
            <p class="text-sm text-muted">
              {t.resourcesEmptyHintTemplate.replace("{game}", groupShortLabel(g))}
            </p>
          </div>
        )}
        {(() => {
          // 扁平化所有分類的 items，保留語言標籤
          const allItems = g.categories.flatMap((c) =>
            c.items.map((item) => {
              // 根據分類名稱推斷語言
              // 這裡比對的 "中文"／"日文" 是 resources.ts 分類名稱的判斷依據（資料層），
              // 不是顯示給使用者的文字，翻譯它會讓語言判斷失效，故保持中文原樣。
              // 變數名用 itemLang 而非 lang，避免遮蔽頁面語言的 lang prop。
              let itemLang = "en";
              if (c.label.includes("中文") || c.id.includes("zh")) itemLang = "zh";
              else if (c.label.includes("日文") || c.id.includes("ja") || c.en.includes("日本語"))
                itemLang = "ja";
              return { ...item, lang: itemLang, starOnly: false };
            })
          );
          // 每個遊戲的清單最後補上 Hsin-Po 的個人網站，但不在預設清單裡顯示，
          // 只有按下星星篩選（站長推薦）才會被搜到，避免每個遊戲頁面都預設洗版
          if (allItems.length > 0) {
            allItems.push({
              title: "Hsin-Po 的個人網站",
              url: RESOURCES_CREDIT.url,
              kind: "site",
              lang: "zh",
              recommended: true,
              note: "Yuda's Discord 資深管理員",
              starOnly: true,
            });
          }
          return (
            <section id={`${g.game}-resources`} class="res-sec scroll-mt-32 pt-6">
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                {allItems.map((item) => (
                  <a
                    href={item.url.startsWith("/") ? href(item.url, lang) : item.url}
                    target={item.url.startsWith("/") ? undefined : "_blank"}
                    rel={item.url.startsWith("/") ? undefined : "noopener"}
                    class="res group flex min-w-0 items-center gap-3.5 rounded-[5px] border border-border-soft bg-surface py-3 pl-3.5 pr-4 no-underline transition-colors hover:border-brand"
                    data-search={`${item.title} ${item.note ?? ""} ${sourceLabel(item.externalUrl ?? item.url)}`.toLowerCase()}
                    data-recommended={item.recommended ? "true" : "false"}
                    data-star-only={item.starOnly ? "true" : "false"}
                  >
                  <span class="flex h-9 w-9 flex-none items-center justify-center rounded-[5px] bg-sand text-muted transition-colors group-hover:text-accent" data-kind={item.kind}>
                    <svg
                      viewBox="0 0 24 24"
                      width="17"
                      height="17"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={KIND_ICONS[item.kind]}
                    />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[15px] font-medium text-ink">
                      {item.title}
                    </span>
                    {item.note && (
                      <span class="block truncate text-[12px] leading-[1.5] text-muted">
                        {item.note}
                      </span>
                    )}
                  </span>
                  <span class="flex flex-none items-center gap-2">
                    <span
                      class={`whitespace-nowrap rounded-[5px] px-2 py-0.5 text-[10px] font-semibold ${
                        item.lang === "zh"
                          ? "bg-sand text-accent"
                          : item.lang === "ja"
                            ? "bg-sand text-lang-tag-ja"
                            : "bg-sand text-lang-tag"
                      }`}
                    >
                      {item.lang === "zh" ? t.resourcesLangZh : item.lang === "ja" ? t.resourcesLangJa : t.resourcesLangEn}
                    </span>
                    <span class="hidden font-mono text-[11px] text-muted sm:inline">
                      {sourceLabel(item.externalUrl ?? item.url)}
                    </span>
                    <span class="res-arrow text-accent" aria-hidden="true">
                      {item.url.startsWith("/") ? "→" : "↗"}
                    </span>
                  </span>
                  </a>
                ))}
              </div>
            </section>
          );
        })()}
        {/* 搜尋／篩選後零筆時的提示。原本的條件寫反了（只有「完全沒有資源的
            遊戲」才渲染這段），結果是有資源的遊戲搜不到東西時整片空白、沒有
            任何說明；而沒有資源的遊戲反而會同時出現「資源整理中」和這句。
            另外它原本擺在 <section class="res-sec"> 裡面——那個 section 在零筆時
            會被 applyFilter() 整個 hidden 掉，訊息跟著一起被藏起來，就算條件
            改對了也永遠看不到。所以它必須待在 section 外、.lib 底下。
            平常靠 hidden class 收著，由 applyFilter() 依 visibleTotal 開關。 */}
        {g.categories.length > 0 && (
          <p class="res-empty hidden pt-16 text-center text-[15px] text-muted">
            {t.resourcesNoMatch}
          </p>
        )}
      </div>
    ))
  }

  <style>
    /* ── 文件頁籤：桌面一排四個、手機 2x2 ── */
    .portal {
      height: clamp(52px, 9vw, 64px);
    }
    .portal-mark {
      width: clamp(24px, 6vw, 32px);
      height: clamp(24px, 6vw, 32px);
      color: var(--muted);
      opacity: 0.55;
      transition: opacity 0.25s ease, color 0.25s ease;
    }
    .r-portal-title {
      font-size: clamp(14px, 3.4vw, 16px);
    }
    .portal:hover .portal-mark {
      opacity: 0.8;
    }
    .portal[aria-pressed="true"] {
      border-color: var(--ink-warm);
      background: color-mix(in srgb, var(--ink-warm) 5%, var(--surface));
    }
    .portal[aria-pressed="true"] .portal-mark {
      color: var(--ink-warm);
      opacity: 0.9;
    }
    .portal[aria-pressed="false"] {
      opacity: 0.75;
    }
    .portal[aria-pressed="false"]:hover {
      opacity: 1;
    }

    /* ── 連結列的 ↗：hover 才浮現 ── */
    .res-arrow {
      opacity: 0;
      transform: translate(-3px, 3px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    .res:hover .res-arrow,
    .res:focus-visible .res-arrow {
      opacity: 1;
      transform: translate(0, 0);
    }

    /* ── 切換遊戲時的錯落浮現 ── */
    @keyframes res-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    .lib.entering .res-sec {
      animation: res-rise 0.45s cubic-bezier(0.22, 0.8, 0.36, 1) both;
      animation-delay: calc(var(--i) * 70ms);
    }

    /* ── 工具列：桌面版吸附在導覽列下方 ── */
    @media (min-width: 821px) {
      .r-res-toolbar {
        position: sticky;
        top: 64px;
        z-index: 40;
      }
    }

    /* ── 篩選時的隱藏 ── */
    .res[hidden],
    .res-sec[hidden] {
      display: none;
    }
    .chip.dim {
      opacity: 0.35;
      pointer-events: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .lib.entering .res-sec {
        animation: none;
      }
      .portal-mark,
      .res-arrow {
        transition: none;
      }
    }

    @media (max-width: 600px) {
      .r-res-hero {
        padding-top: 28px;
        padding-bottom: 24px;
      }
      .r-res-h1 {
        font-size: 26px;
      }
      .r-res-subtitle {
        font-size: 12px;
      }
    }
  </style>

  <script>
    const portals = Array.from(document.querySelectorAll<HTMLButtonElement>(".portal"));
    const libs = Array.from(document.querySelectorAll<HTMLElement>(".lib"));
    const filterBtns = Array.from(document.querySelectorAll<HTMLElement>(".res-filter"));
    const searchInput = document.getElementById("res-search") as HTMLInputElement | null;
    const countEl = document.getElementById("res-count");

    const gameOrder = portals.map((p) => p.dataset.game ?? "");

    let activeGame = "botw";
    let activeKind: string | null = null;

    function applyFilter() {
      const q = (searchInput?.value ?? "").trim().toLowerCase();
      const lib = libs.find((l) => l.dataset.lib === activeGame);
      if (!lib) return;

      let visibleTotal = 0;
      const sections = Array.from(lib.querySelectorAll<HTMLElement>(".res-sec"));
      sections.forEach((sec) => {
        const rows = Array.from(sec.querySelectorAll<HTMLElement>(".res"));
        let visible = 0;
        rows.forEach((row) => {
          const matchesSearch = !q || (row.dataset.search ?? "").includes(q);
          const matchesKind = !activeKind
            // 沒有篩選時：一般項目都算符合，但 starOnly 項目（例：Hsin-Po 的個人網站）
            // 只能透過星星篩選找到，預設清單裡不出現
            ? row.dataset.starOnly !== "true"
            : activeKind === "star"
              ? row.dataset.recommended === "true"
              : row.querySelector("span[data-kind]")?.getAttribute("data-kind") === activeKind;
          const hit = matchesSearch && matchesKind;
          row.hidden = !hit;
          if (hit) visible++;
        });
        sec.hidden = visible === 0;
        visibleTotal += visible;
      });

      const empty = lib.querySelector<HTMLElement>(".res-empty");
      if (empty) empty.classList.toggle("hidden", visibleTotal > 0);
      if (countEl) {
        // 模板由伺服器端寫進 data 屬性（這段 script 沒有 define:vars，拿不到 t）
        const tpl = countEl.dataset.countTpl ?? "{n} 筆符合";
        countEl.textContent = q || activeKind ? tpl.replace("{n}", String(visibleTotal)) : "";
      }
    }

    function setGame(game: string, animate = true) {
      if (!libs.some((l) => l.dataset.lib === game)) return;
      activeGame = game;
      portals.forEach((p) => p.setAttribute("aria-pressed", String(p.dataset.game === game)));
      libs.forEach((l) => {
        const on = l.dataset.lib === game;
        l.hidden = !on;
        l.classList.remove("entering");
        if (on && animate) {
          void l.offsetWidth;
          l.classList.add("entering");
        }
      });
      history.replaceState(null, "", `#${game}`);
      applyFilter();
    }

    portals.forEach((p) =>
      p.addEventListener("click", () => {
        if (p.dataset.game !== activeGame) setGame(p.dataset.game ?? "botw");
      })
    );

    // 這五顆原本是 <a href="#">，已改成 <button type="button" aria-pressed>：
    // 它們的行為是開關而不是導覽，當成連結會被讀屏唸成「連結」、還會污染
    // 瀏覽記錄，而且開／關狀態完全沒有表達出來。改成按鈕後 preventDefault
    // 也不需要了（type="button" 本來就沒有預設行為）。
    filterBtns.forEach((btn) =>
      btn.addEventListener("click", () => {
        // dataset.kind 可能是 undefined；統一收斂成 null，
        // 否則兩顆都缺 data-kind 的按鈕會因 undefined === undefined 被誤判為選中
        const kind = btn.dataset.kind ?? null;
        activeKind = activeKind === kind ? null : kind;
        filterBtns.forEach((b) => {
          const isActive = b.dataset.kind === activeKind;
          b.setAttribute("aria-pressed", isActive ? "true" : "false");
          // 選中態用 ink（「你在這裡」），不能用 brand/accent——按鈕本身的
          // hover 就是 hover:border-brand hover:text-accent，兩者用同一組色的話
          // 「已選中」和「只是滑過去」會長得一模一樣，根本看不出哪個篩選開著。
          b.classList.toggle("border-ink", isActive);
          b.classList.toggle("text-ink", isActive);
          b.classList.toggle("border-border-soft", !isActive);
          b.classList.toggle("text-muted", !isActive);
        });
        applyFilter();
      })
    );

    searchInput?.addEventListener("input", applyFilter);
    searchInput?.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && searchInput.value) {
        searchInput.value = "";
        applyFilter();
      }
    });

    // 沒有 hash（直接打開 /resources）時 initial 會是空字串，落回預設的 botw，
    // 確保 applyFilter() 一定會在首次載入時跑過一次——否則 starOnly 這類
    // 只靠 JS 隱藏的項目，在使用者還沒做任何互動前會維持 SSR 時的預設可見狀態
    const hashGame = location.hash.replace("#", "");
    setGame(gameOrder.includes(hashGame) ? hashGame : "botw", false);
  </script>
</BaseLayout>
