---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SheikahField from "../components/SheikahField.astro";
import { SITE } from "../data/site";
import { href } from "../lib/url";
import type { Lang } from "../data/ui-strings";

interface Props {
  title?: string;
  description?: string;
  /** 導覽列 active 判斷用：home / botw / totk / videos */
  active?: string;
  /** 頁面語言；日文版攻略頁傳 "ja"，其餘頁面沿用預設中文 */
  lang?: Lang;
  /** 這一頁對應到另一語言的路徑（不含語言前綴），例如 "/types/totk-11"。
   *  沒給就代表這一頁還沒有另一語言版本，語言切換鈕不會顯示。 */
  altPath?: string;
}

const { title, description, active = "", lang = "zh", altPath } = Astro.props;
// 站名／預設說明目前只有曠野之息、王國之淚有日文版（見 site.ts），
// 其餘遊戲的頁面仍會沿用中文站名，等資料層翻譯補齊後再全面日文化。
const siteTitle = lang === "ja" ? SITE.titleJa : SITE.title;
const siteDescription = lang === "ja" ? SITE.descriptionJa : SITE.description;
const fullTitle = title ? `${title} · ${siteTitle}` : siteTitle;
const resolvedDescription = description ?? siteDescription;
// lang 屬性要跟著頁面語言走，否則螢幕閱讀器與搜尋引擎會把日文頁誤判為中文
const htmlLang = lang === "ja" ? "ja" : "zh-Hant-TW";

// 社群分享卡片與 canonical 都必須是「絕對網址」——Discord／Line／X 抓不到
// 相對路徑，Google 也需要絕對網址才能正確判斷正規版本。
// Astro.site 是 astro.config.mjs 的 site 欄位，Astro.url.pathname 已含 base。
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(href("/og-image.jpg"), Astro.site).href;

// hreflang：中日文是兩套獨立網址（日文多一層 /ja 前綴），要明講「這兩個是同一頁的
// 不同語言版本」，否則 Google 只能靠內容猜，日本讀者常被導到中文版，一進來就跳出。
// 它不會讓排名變好，是在同一個名次上換成對的語言版本顯示，並把兩版的信號併成一組。
//
// 用 altPath 當開關：它只有在兩種語言都真的存在時才會傳進來（同一個值，中日文頁都傳），
// 所以不會指到 404——配錯對象比不配更糟。入口頁沒有日文版，也沒有走這個 layout。
// 必須雙向互指且包含自己，只有單邊宣告 Google 會整組忽略，故兩版都輸出完整清單。
// 網址結尾補斜線：canonical 與 sitemap 都是這個形式，hreflang 指向非正規網址
// 會在 Search Console 被判定成「沒有回指」。
const altUrl = (target: Lang) =>
  new URL(href(altPath!, target).replace(/\/?$/, "/"), Astro.site).href;
// 繁中用 zh-Hant（依書寫系統）而不是 zh-TW（依地區）：香港、澳門的讀者也該拿到這一版。
// x-default 是「其他語言的人看哪一個」，指向本站預設語言的中文版。
const alternates = altPath
  ? [
      { hreflang: "zh-Hant", url: altUrl("zh") },
      { hreflang: "ja", url: altUrl("ja") },
      { hreflang: "x-default", url: altUrl("zh") },
    ]
  : [];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* iOS Safari 會用 theme-color 去填「頂端安全區域」（狀態列底下、網頁內容
        上面那一條）。沒有這個 meta 時 Safari 用自己的淺色預設值，深色模式下
        就會在導覽列上方出現一條突兀的淺色橫帶——看起來像多餘的 padding 或
        容器，其實是瀏覽器畫的。兩個入口頁本來就有這個 meta，所以只有站內頁
        會出現。初始值跟下方 inline script 的 fallback 一致（深色），
        script 與主題切換鈕都會即時改寫它。
        ※ 刻意不加 viewport-fit=cover：那會讓內容鑽進瀏海／安全區域，
          浮動導覽列可能被狀態列蓋住，是真的會動到版面的改法。 */}
    <meta name="theme-color" content="#0f0304" />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    {/* SVG favicon 在部分平台（iOS 加到主畫面、舊版 Safari）吃不到，補一張 PNG 備援 */}
    <link rel="apple-touch-icon" href={href("/apple-touch-icon.png")} />
    <title>{fullTitle}</title>
    <meta name="description" content={resolvedDescription} />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map(({ hreflang, url }) => (
      <link rel="alternate" hreflang={hreflang} href={url} />
    ))}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={lang === "ja" ? "ja_JP" : "zh_TW"} />
    {/* X／Twitter 不吃 og:image 的大圖版面，要另外指定 card 型別才會顯示大圖 */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Spectral:wght@400;500;600&family=Noto+Serif+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;700&family=DM+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    {/* 首屏前套用主題，避免閃爍。
        這段必須跟 src/pages/index.astro 入口頁那段的判斷邏輯一致——兩邊讀的是
        同一顆 localStorage key（wiki-theme），只要 fallback 方向不同，
        使用者從入口頁點進站內就會閃一次主題。原本這裡的預設是淺色、入口頁是
        深色，差在「系統沒有明確偏好」時；深色才是本站的預設身分，故統一為深色。
        另外 localStorage 的值一定要過白名單：舊版殘留或被寫壞的字串若直接塞進
        data-theme，兩組主題變數會全部落空，整頁變成沒有套用任何主題的狀態。 */}
    <script is:inline>
      (function () {
        var theme = "dark";
        try {
          var saved = localStorage.getItem("wiki-theme");
          if (saved === "light" || saved === "dark") {
            theme = saved;
          } else {
            theme = window.matchMedia("(prefers-color-scheme: light)").matches
              ? "light"
              : "dark";
          }
        } catch (e) {
          theme = "dark";
        }
        document.documentElement.setAttribute("data-theme", theme);
        // theme-color 要跟著實際套用的主題走，否則使用者上次選淺色時，
        // 頂端安全區域仍會被填成深色（或反過來），跟頁面對不起來。
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "light" ? "#f6f6f4" : "#0f0304");
      })();
    </script>
  </head>
  <body class="min-h-screen bg-bg text-text">
    <SheikahField />
    <Header active={active} lang={lang} altPath={altPath} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
