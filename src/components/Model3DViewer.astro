---
import { uiStrings, type Lang } from "../data/ui-strings";
interface Props {
  lang?: Lang;
  src: string;
  alt: string;
  poster?: string;
  posterAlt?: string;
  height?: string;
  aspectRatio?: string;
  mobileAspectRatio?: string;
  minZoomDistance?: number;
  maxZoomDistance?: number;
  cameraOrbit?: string;
  cameraTarget?: string;
  layoutSrc?: string;
  transparencyMaterials?: string[];
  transparencyOpacity?: number;
}
const BASE = import.meta.env.BASE_URL.replace(/\/$/, "");
const {
  lang = "zh", src, alt, poster, posterAlt, height, aspectRatio, mobileAspectRatio,
  minZoomDistance = 0.8, maxZoomDistance = 400, cameraOrbit, cameraTarget,
  layoutSrc, transparencyMaterials, transparencyOpacity = 0.22,
} = Astro.props;
const t = uiStrings[lang];
const resolve = (path: string) => `${BASE}/${path.replace(/^\//, "")}`;
const menuId = `model3d-menu-${crypto.randomUUID()}`;
const floorsId = `${menuId}-floors`;
const coordsId = `${menuId}-coords`;
const sizeStyle = aspectRatio
  ? `--mv-height:auto; --mv-aspect:${aspectRatio}; --mv-aspect-mobile:${mobileAspectRatio ?? aspectRatio};`
  : `--mv-height:${height ?? "480px"};`;
---

<script is:inline src={`${BASE}/vendor/model-viewer.min.js`} type="module"></script>
<div class="model3d-wrap" data-lang={lang} data-layout-src={layoutSrc && resolve(layoutSrc)}
  data-transparency-materials={transparencyMaterials?.join(",")} data-transparency-opacity={transparencyOpacity}
  data-ui={JSON.stringify({ loading: t.model3dLoading, error: t.model3dLoadError,
    layoutError: t.model3dLayoutError, fullscreen: t.model3dFullscreenLabel,
    exitFullscreen: t.model3dExitFullscreenLabel, coordsInvalid: t.model3dCoordsInvalid,
    coordsNoSurface: t.model3dCoordsNoSurface })}>
  <div class="model3d-stage" style={sizeStyle}>
    <model-viewer src={resolve(src)} alt={alt} poster={poster && resolve(poster)} poster-alt={posterAlt}
      camera-controls touch-action="none" interaction-prompt="none" loading="lazy"
      camera-orbit={cameraOrbit} camera-target={cameraTarget} field-of-view="30deg"
      min-camera-orbit={`auto 0deg ${minZoomDistance}m`} max-camera-orbit={`auto 88deg ${maxZoomDistance}m`}
      shadow-intensity="0" exposure="1" class="model3d-viewer">
      <div slot="progress-bar" class="model3d-progress" aria-hidden="true"></div>
      <div slot="hotspot-pin" class="model3d-pin" data-position="0 0 0" data-normal="0 1 0"
        role="img" aria-label={t.model3dPinLabel} hidden></div>
    </model-viewer>
    <span class="model3d-loading" role="status">{t.model3dLoading}</span>
    <div class="model3d-controls">
      <button type="button" class="model3d-menu-toggle" aria-label={t.model3dMenuLabel}
        aria-expanded="false" aria-controls={menuId} title={t.model3dMenuLabel}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
      </button>
      <div id={menuId} class="model3d-menu" hidden>
        <button type="button" class="model3d-action" data-action="reset">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11a9 9 0 1 1 2 7M3 4v7h7" /></svg>
          <span>{t.model3dResetLabel}<small>{t.model3dResetHint}</small></span>
        </button>
        {layoutSrc && <>
          <button type="button" class="model3d-action" data-action="floors" aria-expanded="false" aria-controls={floorsId} disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5" /></svg>
            <span>{t.model3dFloorsLabel}</span>
          </button>
          <form id={floorsId} class="model3d-panel" data-panel="floors" hidden>
            <label for={`${floorsId}-select`}>{t.model3dSelectFloor}</label>
            <div class="model3d-floor-input">
              <select id={`${floorsId}-select`} name="floor" required></select>
              <button type="submit">{t.model3dGoLabel}</button>
            </div>
          </form>
          <button type="button" class="model3d-action" data-action="coords" aria-expanded="false" aria-controls={coordsId} disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-6-5.3-6-10a6 6 0 0 1 12 0c0 4.7-6 10-6 10Z" /><circle cx="12" cy="11" r="2" /></svg>
            <span>{t.model3dCoordsLabel}</span>
          </button>
          <form id={coordsId} class="model3d-panel" data-panel="coords" hidden>
            <label for={`${coordsId}-input`}>{t.model3dCoordsField}</label>
            <div class="model3d-floor-input">
              <input id={`${coordsId}-input`} name="coords" type="text" inputmode="text" autocomplete="off"
                spellcheck="false" enterkeyhint="go" placeholder={t.model3dCoordsPlaceholder} required />
              <button type="submit">{t.model3dGoLabel}</button>
            </div>
          </form>
        </>}
        {transparencyMaterials?.length && <button type="button" class="model3d-action" data-action="transparency" aria-pressed="false" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 9 5v8l-9 5-9-5V8l9-5ZM3 8l9 5 9-5M12 13v8M12 3v10" /></svg>
          <span>{t.model3dTransparencyLabel}</span>
          <svg class="model3d-check" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
        </button>}
        {layoutSrc && <button type="button" class="model3d-action" data-action="overview" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3V6ZM9 3v15M15 6v15" /></svg>
          <span>{t.model3dOverviewLabel}</span>
        </button>}
        <button type="button" class="model3d-action" data-action="fullscreen" aria-pressed="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 3H3v5M16 3h5v5M3 16v5h5M21 16v5h-5" /></svg>
          <span>{t.model3dFullscreenLabel}</span>
        </button>
      </div>
    </div>
    <button type="button" class="model3d-exit" hidden aria-label={t.model3dExitFullscreenLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
      {t.model3dExitFullscreenLabel}
    </button>
  </div>
  <div class="model3d-pick-info" role="status" data-hint={t.model3dPickInfo} data-picked-tpl={t.model3dPickedTemplate}>
    {t.model3dPickInfo}
  </div>
</div>

<style>
  .model3d-wrap { position: relative; }
  .model3d-stage { position: relative; }
  .model3d-viewer {
    display: block; width: 100%; height: var(--mv-height, 480px); aspect-ratio: var(--mv-aspect, auto); max-height: 72svh;
    border-radius: 5px; background: var(--surface); box-shadow: 0 0 0 1px var(--border-strong);
    --poster-color: transparent;
  }
  .model3d-wrap [hidden] { display: none !important; }
  .model3d-wrap svg { width: 20px; height: 20px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .model3d-controls { position: absolute; top: 12px; right: 12px; z-index: 2; }
  .model3d-menu-toggle, .model3d-exit {
    display: flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px;
    color: var(--ink); background: var(--surface); border: 1px solid var(--border-strong); border-radius: 6px; cursor: pointer;
    box-shadow: 0 2px 10px #00000012;
  }
  .model3d-menu-toggle:hover, .model3d-menu-toggle[aria-expanded="true"] { border-color: var(--brand); color: var(--brand); }
  .model3d-menu {
    position: absolute; right: 0; top: 52px; width: 258px; max-width: calc(100vw - 72px);
    max-height: min(420px, 65vh); overflow-y: auto; overscroll-behavior: contain; padding: 6px;
    border: 1px solid var(--border-strong); border-radius: 8px; background: var(--surface);
    box-shadow: 0 8px 28px #00000024; color: var(--ink);
  }
  .model3d-action {
    display: flex; align-items: center; gap: 12px; width: 100%; min-height: 44px; padding: 10px;
    text-align: left; font: inherit; font-size: 14px; line-height: 1.4; border: 0; border-radius: 4px;
    color: var(--ink); background: transparent; cursor: pointer;
  }
  .model3d-action:hover, .model3d-action[aria-pressed="true"] { background: var(--bg); color: var(--brand); }
  .model3d-action:disabled { opacity: .45; cursor: wait; }
  .model3d-action small { display: block; margin-top: 3px; font-size: 11px; color: var(--muted); }
  .model3d-action .model3d-check { margin-left: auto; visibility: hidden; width: 16px; }
  .model3d-action[aria-pressed="true"] .model3d-check { visibility: visible; }
  .model3d-wrap :is(button, select):focus-visible { outline: 2px solid var(--brand); outline-offset: 2px; }
  .model3d-panel { margin: 2px 6px 8px; padding: 10px; border-radius: 4px; background: var(--bg); }
  .model3d-panel label { display: block; font-size: 12px; color: var(--muted); margin-bottom: 6px; }
  .model3d-floor-input { display: flex; gap: 6px; }
  .model3d-floor-input :is(select, input, button) { min-height: 44px; border: 1px solid var(--border-strong); border-radius: 4px; font-family: inherit; font-size: 13px; }
  .model3d-floor-input :is(select, input) { flex: 1; min-width: 0; background: var(--surface); color: var(--ink); padding: 0 6px; }
  .model3d-pin {
    width: 12px; height: 12px; border-radius: 50%; background: var(--ink); border: 2px solid var(--surface);
    box-shadow: 0 0 0 1px var(--border-strong), 0 2px 6px #0006; pointer-events: none;
  }
  .model3d-floor-input button { padding: 0 10px; background: var(--ink); color: var(--bg); cursor: pointer; }
  .model3d-pick-info { margin-top: 8px; font-size: 13px; color: var(--muted); line-height: 1.6; }
  .model3d-pick-info.is-picked { color: var(--ink); }
  .model3d-loading { position: absolute; left: 12px; bottom: 12px; padding: 6px 10px; border-radius: 4px; background: var(--surface); color: var(--muted); font-size: 12px; pointer-events: none; }
  .model3d-progress { position: absolute; top: 0; left: 0; height: 3px; width: calc(var(--progress, 0) * 100%); background: var(--brand); }
  .model3d-exit { position: absolute; left: 12px; top: 12px; z-index: 2; gap: 6px; padding: 0 12px; font-size: 13px; }
  .model3d-wrap:fullscreen, .model3d-wrap.is-fullscreen {
    display: flex; flex-direction: column; background: var(--surface); padding: 12px;
    width: 100%; height: 100%; box-sizing: border-box;
  }
  .model3d-wrap.is-fullscreen { position: fixed; inset: 0; z-index: 100; height: 100dvh; }
  .model3d-wrap:is(:fullscreen, .is-fullscreen) .model3d-stage { flex: 1; min-height: 0; }
  .model3d-wrap:is(:fullscreen, .is-fullscreen) .model3d-viewer { height: 100%; aspect-ratio: auto; max-height: none; }
  .model3d-wrap:is(:fullscreen, .is-fullscreen) .model3d-pick-info { flex: none; }
  @media (max-width: 767px) {
    .model3d-viewer { aspect-ratio: var(--mv-aspect-mobile, var(--mv-aspect, auto)); }
    .model3d-controls { top: 10px; right: 10px; }
  }
</style>

<script>
  import "../scripts/model3d-viewer";
</script>
