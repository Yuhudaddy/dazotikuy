---
// 單一分頁（或子分頁）的內容本體：適合標籤、intro、sections/bullets/steps、note。
// 從 src/pages/types/[id].astro 抽出來，讓「合併分頁＋子分頁」（如 R0 Cull Zuggle 底下的
// In Bound / Out of Bound）可以重複使用同一套渲染邏輯，不用整段複製。
import { href } from "../lib/url";
import type { FlowMapStepAction, TypeMethod } from "../data/type-content";
import { parseAccent, parseStep, stepParts } from "../lib/method-format";
import { getFlowRoute } from "../lib/flow-route";
import { uiStrings, type Lang } from "../data/ui-strings";

interface Props {
  method: TypeMethod;
  mapGroup?: string; // 「參照流程地圖」單選按鈕的群組識別字（呼叫端以 method 索引組成，
                     // 每個分頁／子分頁一組，避免不同分頁的 radio 互相搶選取狀態）。
                     // 未傳或 method 沒有 mapFlow 時不渲染單選按鈕
  lang?: Lang;
}
const { method: m, mapGroup, lang = "zh" } = Astro.props;
const t = uiStrings[lang];

// 步驟地圖行為 → data-map 的 JSON。route 是檔名，這裡在建置期換成實際的線段座標，
// 前端就不必再 fetch（routeNote 併進 route.note，前端只看一個物件）。
function mapData(action: FlowMapStepAction, stepNo: number) {
  const { route, routeNote, ...rest } = action;
  const resolved = route ? getFlowRoute(route, routeNote) : undefined;
  return JSON.stringify({ ...rest, ...(resolved ? { route: resolved } : {}), stepNo });
}
---

{/* 白標題與適合／難易度標籤可同時存在：有 name 時標題在上、標籤列接在下方。
    先前寫成三元判斷，導致 12 個同時設了 name 與 tags 的分頁（如 BLSS 的
    ～Ver.1.6.0、MSD 的 ～Ver.1.1.1）版本限制標籤完全不顯示。 */}
{m.name && (
  <div class:list={["text-[15px] font-medium text-ink", (m.tags && m.tags.length > 0) || m.difficulty || m.timeCost ? "mb-2" : "mb-3"]}>
    {m.name}
  </div>
)}
{((m.tags && m.tags.length > 0) || m.difficulty || m.timeCost) && (
  <div class="mb-3 flex flex-wrap items-center gap-2">
    {m.tags && m.tags.length > 0 && (
      <>
        <span class="text-[13px] text-ink">{t.tagsLabel}</span>
        {m.tags.map((tag) => (
          <span class="inline-block rounded-[5px] bg-surface px-3 py-1 text-[13px] text-muted shadow-[0_0_0_1px_var(--border-strong)]">
            {tag}
          </span>
        ))}
      </>
    )}
    {m.difficulty && (
      <span class="inline-block rounded-[5px] bg-surface px-3 py-1 text-[13px] text-muted shadow-[0_0_0_1px_var(--border-strong)]">
        {t.difficultyLabel}{m.difficulty}
      </span>
    )}
    {m.timeCost && (
      <span class="inline-block rounded-[5px] bg-surface px-3 py-1 text-[13px] text-muted shadow-[0_0_0_1px_var(--border-strong)]">
        {t.timeCostLabel}{m.timeCost}
      </span>
    )}
  </div>
)}
{m.intro && (
  <p class="mb-3 text-[13px] leading-[1.7] text-muted">{m.intro}</p>
)}
{m.sections ? (
  m.sections.map((sec) => {
    // title 可省略：同一個方法（已有 TypeMethod.name 當白色總標題）底下純粹依
    // 版本／條件分段時，不需要每段各自再掛一次橘色小標題（例：木箱擊飛的
    // Switch 1／Switch 2 兩段）
    const titleNode = sec.title ? (
      <div class={m.sections!.length === 1 ? "method-section-title-single" : "method-section-title"}>
        {parseAccent(sec.title).map((seg) =>
          seg.accent ? <span class="accent-strong">{seg.text}</span> : seg.text
        )}
      </div>
    ) : null;
    const tagsNode = sec.tags && sec.tags.length > 0 && (
      <div class="mb-3 flex flex-wrap items-center gap-2">
        <span class="text-[13px] text-ink">{t.tagsLabel}</span>
        {sec.tags.map((tag) => (
          <span class="inline-block rounded-[5px] bg-surface px-3 py-1 text-[13px] text-muted shadow-[0_0_0_1px_var(--border-strong)]">
            {tag}
          </span>
        ))}
      </div>
    );
    const subtitleNode = sec.subtitle && (
      <div class="method-section-title">
        {parseAccent(sec.subtitle).map((seg) =>
          seg.accent ? <span class="accent-strong">{seg.text}</span> : seg.text
        )}
      </div>
    );
    const body = (
      <>
        {sec.intro && (
          <p class="mb-3 text-[13px] leading-[1.7] text-muted">{sec.intro}</p>
        )}
        {!sec.collapsible && tagsNode}
        {subtitleNode}
        {/* steps 可省略：只有標題與 tags 的區塊當作純標頭用（例：變體名稱），
            此時不要生出空的 <ol>，否則會多一段列表的上下留白 */}
        {sec.steps && sec.steps.length > 0 && (
        <ol>
          {sec.steps.map((s, idx) => {
            const { text, sub } = stepParts(s);
            // sections 版的步驟地圖連動：與 TypeMethod.steps 版共用同一顆
            // flow-step-radio／同一個 mapGroup（同一頁只有一張地圖），但資料
            // 來源改看 sec.mapFlow（每個區塊各自從 0 索引，跟着自己的 steps）
            const mapAction = mapGroup ? sec.mapFlow?.[idx] : undefined;
            return (
              <li>
                {mapAction && (
                  <input
                    type="radio"
                    class="flow-step-radio"
                    name={`flow-steps-${mapGroup}`}
                    data-map={mapData(mapAction, idx + 1)}
                    aria-label={t.mapStepAriaLabelTemplate.replace("{n}", String(idx + 1))}
                    title={t.mapStepTitle}
                  />
                )}
                {parseStep(text).map((seg) =>
                  seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                    : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                    : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                )}
                {sub.length > 0 && (
                  <ul class="step-sub">
                    {sub.map((d) => (
                      <li class={/^[（(]/.test(d) ? "step-sub-deep" : ""}>
                        {parseStep(d).map((seg) =>
                          seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                            : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                            : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
        )}
        {sec.note && (
          Array.isArray(sec.note) ? (
            <div class="mt-4 space-y-1">
              {sec.note.map((n) => (
                <p class="text-[13px] leading-[1.7] text-muted">
                  {parseStep(n).map((seg) =>
                    seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                      : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                      : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                  )}
                </p>
              ))}
            </div>
          ) : (
            <p class="mt-4 text-[13px] leading-[1.7] text-muted">
              {parseStep(sec.note).map((seg) =>
                seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                  : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                  : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
              )}
            </p>
          )
        )}
        {/* 子技巧的完整步驟：預設隱藏，由主流程步驟裡的 [[文字|popover]] 連結點開。
            寬螢幕時貼在觸發連結旁邊浮出，窄螢幕時變成置中的對話框（見 [id].astro
            的定位邏輯與樣式）。刻意不直接排在主流程下方——並排會讓人誤以為那是
            「同一件事的另一種做法」，但它其實只是其中一個步驟用到的工具。 */}
        {sec.popover && sec.popover.steps.length > 0 && (
          <div class="step-popover" data-step-popover hidden>
            <button
              type="button"
              class="step-popover-backdrop"
              tabindex="-1"
              aria-hidden="true"
              data-step-popover-close
            ></button>
            <div class="step-popover-panel" role="dialog" aria-modal="true" aria-label={sec.popover.title}>
              <div class="step-popover-head">
                {sec.popover.title && (
                  <div class="step-popover-title">
                    {parseAccent(sec.popover.title).map((seg) =>
                      seg.accent ? <span class="accent-strong">{seg.text}</span> : seg.text
                    )}
                  </div>
                )}
                <button type="button" data-step-popover-close aria-label={t.closeAppList}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
                  </svg>
                </button>
              </div>
              <ol>
              {sec.popover.steps.map((s) => {
                const { text, sub } = stepParts(s);
                return (
                  <li>
                    {parseStep(text).map((seg) =>
                      seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                        : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                        : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                    )}
                    {sub.length > 0 && (
                      <ul class="step-sub">
                        {sub.map((d) => (
                          <li class={/^[（(]/.test(d) ? "step-sub-deep" : ""}>
                            {parseStep(d).map((seg) =>
                              seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                                : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                                : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                            )}
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                );
              })}
              </ol>
            </div>
          </div>
        )}
      </>
    );

    return sec.collapsible ? (
      <details class="method-section-collapse">
        <summary class="method-section-collapse-summary">
          {(titleNode || sec.videoUrl) && (
            <div class="method-section-head">
              {titleNode}
              {sec.videoUrl && (
                <a class="section-video-link" href={sec.videoUrl} target="_blank" rel="noopener">
                  <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11">
                    <polygon points="6,4 20,12 6,20"></polygon>
                  </svg>
                  <span>{t.tutorialVideoLink}</span>
                </a>
              )}
            </div>
          )}
          {tagsNode && <div class="method-section-collapse-tags">{tagsNode}</div>}
          <svg class="method-section-collapse-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </summary>
        <div class="method-section-collapse-body">{body}</div>
      </details>
    ) : (
      <div class="method-section">
        {(titleNode || sec.videoUrl) && (
          <div class="method-section-head">
            {titleNode}
            {sec.videoUrl && (
              <a class="section-video-link" href={sec.videoUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" fill="currentColor" width="11" height="11">
                  <polygon points="6,4 20,12 6,20"></polygon>
                </svg>
                <span>{t.tutorialVideoLink}</span>
              </a>
            )}
          </div>
        )}
        {body}
      </div>
    );
  })
) : m.bullets ? (
  <ul>
    {m.bullets.map((b) => (
      <li>
        {parseAccent(b.replace(/^・\s*/, "")).map((seg) =>
          seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
        )}
      </li>
    ))}
  </ul>
) : (
  <ol start={m.stepStart}>
    {(m.steps ?? []).map((s, idx) => {
      const { text, sub } = stepParts(s);
      // 「參照流程地圖」的步驟單選按鈕：地圖行為以 JSON 塞進 data-map，
      // 由 [id].astro 的腳本統一監聽 change 後派發 flowmap:show 事件
      const mapAction = mapGroup ? m.mapFlow?.[idx] : undefined;
      return (
        <li>
          {mapAction && (
            <input
              type="radio"
              class="flow-step-radio"
              name={`flow-steps-${mapGroup}`}
              data-map={mapData(mapAction, idx + 1)}
              aria-label={t.mapStepAriaLabelTemplate.replace("{n}", String(idx + 1))}
              title={t.mapStepTitle}
            />
          )}
          {parseStep(text).map((seg) =>
            seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
              : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
              : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
          )}
          {sub.length > 0 && (
            <ul class="step-sub">
              {sub.map((d) => (
                <li class={/^[（(]/.test(d) ? "step-sub-deep" : ""}>
                  {parseStep(d).map((seg) =>
                    seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
                      : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
                      : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
                  )}
                </li>
              ))}
            </ul>
          )}
        </li>
      );
    })}
  </ol>
)}
{m.note && (
  Array.isArray(m.note) ? (
    <div class="mt-4 space-y-1">
      {m.note.map((n) => (
        <p class="text-[13px] leading-[1.7] text-muted">
          {parseStep(n).map((seg) =>
            seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
              : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
              : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
          )}
        </p>
      ))}
    </div>
  ) : (
    <p class="mt-4 text-[13px] leading-[1.7] text-muted">
      {parseStep(m.note).map((seg) =>
        seg.popover ? <button type="button" class="accent-link step-popover-open" data-step-popover-open>{seg.text}</button>
                    : seg.jumpTab ? <button type="button" class="accent-link jump-tab-btn" data-jump-tab={seg.jumpTab}>{seg.text}</button>
          : seg.href ? (seg.external
                    ? <a href={seg.href} class="accent-link" target="_blank" rel="noopener noreferrer">{seg.text}</a>
                    : <a href={href(`/types/${seg.href}`, lang)} class="accent-link">{seg.text}</a>)
          : seg.accent ? <span class="accent-text">{seg.text}</span> : seg.text
      )}
    </p>
  )
)}
