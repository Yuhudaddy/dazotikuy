{
  "name": "dazotikuy",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "media:push": "rclone copy media-source/type-videos r2:botw-totk-wiki-media/type-videos --exclude .DS_Store --transfers 8 --progress --header-upload \"Cache-Control: public, max-age=2592000\" && node scripts/media-manifest.mjs",
    "media:pull": "rclone copy r2:botw-totk-wiki-media/type-videos media-source/type-videos --transfers 8 --progress",
    "media:check": "rclone check media-source/type-videos r2:botw-totk-wiki-media/type-videos --exclude .DS_Store",
    "media:verify": "node scripts/media-manifest.mjs --verify",
    "media:verify-refs": "node --experimental-strip-types scripts/media-manifest.mjs --verify-references",
    "ja:draft": "node --experimental-strip-types scripts/gen-ja-draft.mjs",
    "og:gen": "node scripts/gen-og-image.mjs",
    "data:verify": "node --experimental-strip-types scripts/verify-data.mjs",
    "tots:sync": "node --experimental-strip-types scripts/sync-tots-web.mjs",
    "tots:verify": "astro build && node --experimental-strip-types scripts/verify-tots-model.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.1.0",
    "astro": "^6.4.7",
    "tailwindcss": "^4.1.0"
  },
  "overrides": {
    "vite": "^7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "typescript": "^6.0.3"
  }
}
